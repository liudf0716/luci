        ["quickapp.cn"] = "快应用生态联盟",
        ["fengkongcloud.cn"] = "数美科技智能风控",
        ["geetest.com"] = "极验智能人机验证",
        ["shuzilm.cn"] = "数盟设备安全指纹",
        ["portal101.cn"] = "路由器热点门户认证",
        ["esheep.com"] = "ESheep 开发者社区",
        ["aikobo.cn"] = "爱扣博云服务",
        ["ntp.org"] = "国际标准网络时间 (NTP)",
        ["nist.gov"] = "美国国家标准时间授时",
        ["mixpanel.com"] = "Mixpanel 数据统计与分析",
        ["irs03.com"] = "艾瑞市场网络数据调研",
        ["ugcimg.cn"] = "网络用户内容多媒体托管",
        ["gshdw.cyou"] = "网络应用连接节点"
    }

    if map[domain] then return map[domain] end

    for k, v in pairs(map) do
        if domain == k or domain:sub(-#k - 1) == "." .. k then
            return v
        end
    end

    if domain:find("bili") then return "哔哩哔哩 (B站相关服务)" end
    if domain:find("google") then return "谷歌服务 (Google相关)" end
    if domain:find("apple") then return "苹果服务 (Apple相关)" end
    if domain:find("tencent") or domain:find("wechat") or domain:find("weixin") then return "腾讯/微信服务" end
    if domain:find("xiaomi") or domain:find("miui") then return "小米生态服务" end
    if domain:find("byted") or domain:find("douyin") or domain:find("volc") then return "字节跳动/抖音服务" end
    if domain:find("ali") or domain:find("taobao") then return "阿里/淘宝服务" end
    if domain:find("jd%.") or domain:find("jdcache") then return "京东商城服务" end

    return "互联网网站/服务"
end

local function get_l7_proto_cn(proto)
    local l7_map = {
        ["SSH"] = "SSH 远程终端管理",
        ["HTTP"] = "HTTP 基础网页传输",
        ["HTTPS"] = "HTTPS 加密网页与API",
        ["WebRTC"] = "WebRTC 音视频通话/直播",
        ["WeChat"] = "微信业务与聊天数据",
        ["DNS"] = "DNS 域名解析服务",
        ["QUIC"] = "QUIC / HTTP3 高速传输",
        ["NTP"] = "NTP 网络时钟授时",
        ["DHCP"] = "DHCP 局域网地址分配",
        ["RTP"] = "RTP 实时音视频传输",
        ["Unknown"] = "其他未识别特征流量"
    }
    return l7_map[proto] or (proto .. " 协议")
end

local f_l7 = io.popen("/usr/bin/aw-bpfctl l7 json all 2>/dev/null")
local s_l7 = f_l7 and f_l7:read("*a") or ""
if f_l7 then f_l7:close() end
local obj_l7 = json.parse(s_l7)
local domains_list = (obj_l7 and obj_l7.data and obj_l7.data.domains) or {}
table.sort(domains_list, function(a,b) return (a.access_count or 0) > (b.access_count or 0) end)
local top_domains = {}
for i = 1, math.min(10, #domains_list) do
    local d = domains_list[i].domain or ""
    table.insert(top_domains, {
        domain = d,
        cn_name = get_domain_cn(d),
        access_count = domains_list[i].access_count
    })
end

local f_sid = io.popen("/usr/bin/aw-bpfctl sid json all 2>/dev/null")
local s_sid = f_sid and f_sid:read("*a") or ""
if f_sid then f_sid:close() end
local obj_sid = json.parse(s_sid)

local all_rate_list = {}
local l7_app_list = {}

if obj_sid and obj_sid.data then
    for _, item in ipairs(obj_sid.data) do
        local name = ""
        local cn_name = ""
        local itype = item.sid_type or ""
        if itype == "L7" then
            name = item.l7_proto_desc or "Unknown"
            cn_name = get_l7_proto_cn(name)
        elseif itype == "Domain" then
            name = item.domain or "Unknown"
            cn_name = get_domain_cn(name)
        end
        local in_rate = item.incoming and item.incoming.rate or 0
        local out_rate = item.outgoing and item.outgoing.rate or 0
        local in_bytes = item.incoming and item.incoming.total_bytes or 0
        local out_bytes = item.outgoing and item.outgoing.total_bytes or 0
        local total_rate = in_rate + out_rate
        local total_bytes = in_bytes + out_bytes

        local entry = {
            name = name,
            cn_name = cn_name,
            type = (itype == "L7") and "L7应用协议" or "域名访问",
            rate_bytes = total_rate,
            rate_human = format_rate(total_rate),
            dl_rate_bytes = in_rate,
            ul_rate_bytes = out_rate,
            dl_rate_human = format_rate(in_rate),
            ul_rate_human = format_rate(out_rate),
            total_bytes = total_bytes,
            total_bytes_human = format_bytes(total_bytes)
        }
        table.insert(all_rate_list, entry)
        if itype == "L7" and name ~= "Unknown" then
            table.insert(l7_app_list, {
                app = name,
                cn_name = cn_name,
                rate_bytes = total_rate,
                rate_human = format_rate(total_rate),
                dl_rate_bytes = in_rate,
                ul_rate_bytes = out_rate,
                dl_rate_human = format_rate(in_rate),
                ul_rate_human = format_rate(out_rate),
                total_bytes = total_bytes,
                total_bytes_human = format_bytes(total_bytes)
            })
        end
    end
end

table.sort(all_rate_list, function(a, b)
    if a.rate_bytes ~= b.rate_bytes then return a.rate_bytes > b.rate_bytes end
    if a.total_bytes ~= b.total_bytes then return a.total_bytes > b.total_bytes end
    return a.name > b.name
end)

table.sort(l7_app_list, function(a, b)
    if a.rate_bytes ~= b.rate_bytes then return a.rate_bytes > b.rate_bytes end
    if a.total_bytes ~= b.total_bytes then return a.total_bytes > b.total_bytes end
    return a.app > b.app
end)

local top_all_rates = {}
for i = 1, math.min(10, #all_rate_list) do
    table.insert(top_all_rates, all_rate_list[i])
end

local top_l7_apps = {}
for i = 1, math.min(10, #l7_app_list) do
    table.insert(top_l7_apps, l7_app_list[i])
end

local output = {
    result = {
        top_l7_apps = top_l7_apps,
        top_services_by_rate = top_all_rates,
        top_domains = top_domains
    }
}
print(json.stringify(output))
'
        }

        get_hw_offload_status() {
            local sw_offload=$(uci -q get firewall.@defaults[0].flow_offloading || echo "0")
            local hw_offload=$(uci -q get firewall.@defaults[0].flow_offloading_hw || echo "0")
            local nft_hw_active=0
            local ppe_supported=0
            local ppe_entries=0
            local selective_ppe=0
            local mode="off"
            local mode_text="硬件加速已关闭"

            if [ "$sw_offload" = "1" ] && [ "$hw_offload" = "1" ]; then
                mode="hw"
                mode_text="硬件加速已开启 (MediaTek PPE 硬件流表分流)"
            elif [ "$sw_offload" = "1" ]; then
                mode="sw"
                mode_text="软件加速已开启 (CPU flowtable)"
            fi

            if command -v nft >/dev/null 2>&1; then
                if nft list table inet fw4 2>/dev/null | grep -q 'flags offload'; then
                    nft_hw_active=1
                fi
            fi

            if [ -d /sys/kernel/debug/ppe0 ]; then
                ppe_supported=1
                if [ -f /sys/kernel/debug/ppe0/entries ]; then
                    ppe_entries=$(wc -l < /sys/kernel/debug/ppe0/entries 2>/dev/null || echo 0)
                fi
            fi

            if [ -x /usr/libexec/aw-bpf/aw-ppe-offload.sh ]; then
                selective_ppe=1
            fi

            local enabled=0
            [ "$mode" = "hw" ] && enabled=1

            json_init
            json_add_object "result"
            json_add_boolean "enabled" "$enabled"
            json_add_string "mode" "$mode"
            json_add_string "mode_text" "$mode_text"
            json_add_string "flow_offloading" "$sw_offload"
            json_add_string "flow_offloading_hw" "$hw_offload"
            json_add_boolean "nft_hw_active" "$nft_hw_active"
            json_add_boolean "ppe_supported" "$ppe_supported"
            json_add_int "ppe_entries" "$ppe_entries"
            json_add_boolean "selective_ppe" "$selective_ppe"
            json_close_object
            json_dump
        }

        set_hw_offload() {
            read -r input
            json_load "$input"
            json_get_var enabled "enabled"
            json_get_var mode "mode"

            if [ -n "$mode" ]; then
                case "$mode" in
                    hw) enabled="1" ;;
                    sw) enabled="sw" ;;
                    off) enabled="0" ;;
                esac
            fi

            local success=0
            local msg=""

            if [ "$enabled" = "1" ] || [ "$enabled" = "true" ]; then
                uci -q set firewall.@defaults[0].flow_offloading='1'
                uci -q set firewall.@defaults[0].flow_offloading_hw='1'
                uci commit firewall
                /etc/init.d/firewall reload >/dev/null 2>&1
                success=1
                msg="硬件加速已成功开启！MediaTek PPE 芯片级硬件 NAT 流表分流已生效，千兆转发吞吐显著提升并大幅降低 CPU 占用。"
            elif [ "$enabled" = "sw" ]; then
                uci -q set firewall.@defaults[0].flow_offloading='1'
                uci -q set firewall.@defaults[0].flow_offloading_hw='0'
                uci commit firewall
                /etc/init.d/firewall reload >/dev/null 2>&1
                success=1
                msg="已切换为纯软件加速模式（关闭 PPE 硬件分流，保留内核软件流表）。"
            else
                uci -q set firewall.@defaults[0].flow_offloading='0'
                uci -q set firewall.@defaults[0].flow_offloading_hw='0'
                uci commit firewall
                /etc/init.d/firewall reload >/dev/null 2>&1
                success=1
                msg="硬件加速已关闭！所有数据包将通过 Linux 标准网络协议栈与 eBPF 过滤链路处理。"
            fi

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        run_with_timeout() {
            local timeout=$1
            shift
            "$@" &
            local pid=$!
            ( sleep "$timeout" && kill -9 "$pid" 2>/dev/null ) &
            local watcher=$!
            wait "$pid" 2>/dev/null
            local ret=$?
            kill -9 "$watcher" 2>/dev/null
            wait "$watcher" 2>/dev/null
            return $ret
        }

        get_router_ssh_key() {
            local key_file="/etc/clawwrt/id_dropbear"
            if [ ! -f "$key_file" ]; then
                mkdir -p /etc/clawwrt
                dropbearkey -t ed25519 -f "$key_file" >/dev/null 2>&1
            fi

            local pubkey=$(dropbearkey -y -f "$key_file" 2>/dev/null | grep '^ssh-')
            local auth_cmd="mkdir -p ~/.ssh && chmod 700 ~/.ssh && echo '${pubkey}' >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys"
            local fingerprint=$(dropbearkey -y -f "$key_file" 2>/dev/null | grep -i 'fingerprint' | head -n1 | sed -e 's/.*Fingerprint: //' -e 's/.*fingerprint: //')

            json_init
            json_add_object "result"
            json_add_string "pubkey" "$pubkey"
            json_add_string "auth_cmd" "$auth_cmd"
            json_add_string "key_type" "ed25519"
            json_add_string "fingerprint" "$fingerprint"
            json_close_object
            json_dump
        }

        get_vps_servers() {
            json_init
            json_add_object "result"
            json_add_array "servers"

            [ -f /etc/config/clawwrt ] && config_load clawwrt
            local count=0
            handle_vps() {
                local s="$1"
                local name host port user status last_check frps_status xkcptun_status has_sudo message rtt_ms
                config_get name "$s" name "$s"
                config_get host "$s" host ""
                config_get port "$s" port "22"
                config_get user "$s" user "root"
                config_get status "$s" status "unknown"
                config_get last_check "$s" last_check ""
                config_get frps_status "$s" frps_status "uninstalled"
                config_get xkcptun_status "$s" xkcptun_status "uninstalled"
                config_get has_sudo "$s" has_sudo "1"
                config_get message "$s" message ""
                config_get rtt_ms "$s" rtt_ms ""

                [ -z "$host" ] && return

                count=$((count + 1))
                json_add_object
                json_add_string "id" "$s"
                json_add_string "name" "$name"
                json_add_string "host" "$host"
                json_add_string "port" "$port"
                json_add_string "user" "$user"
                json_add_string "status" "$status"
                json_add_string "last_check" "$last_check"
                json_add_string "frps_status" "$frps_status"
                json_add_string "xkcptun_status" "$xkcptun_status"
                json_add_string "has_sudo" "$has_sudo"
                json_add_string "message" "$message"
                json_add_string "rtt_ms" "$rtt_ms"
                json_close_object
            }
            config_foreach handle_vps vps 2>/dev/null

            json_close_array
            json_add_int "total" "$count"
            json_close_object
            json_dump
        }

        manage_vps_server() {
            read -r input
            json_load "$input"
            json_get_var action "action"
            json_get_var id "id"
            json_get_var name "name"
            json_get_var host "host"
            json_get_var port "port"
            json_get_var user "user"

            port="${port:-22}"
            user="${user:-root}"

            case "$action" in
                add)
                    [ -z "$host" ] && {
                        json_init
                        json_add_object "result"
                        json_add_boolean "success" 0
                        json_add_string "message" "缺少服务器 IP 或域名"
                        json_close_object
                        json_dump
                        return
                    }
                    local sid="vps_$(date +%s)_$((RANDOM % 1000))"
                    [ -z "$name" ] && name="$host"

                    uci set clawwrt."$sid"=vps
                    uci set clawwrt."$sid".name="$name"
                    uci set clawwrt."$sid".host="$host"
                    uci set clawwrt."$sid".port="$port"
                    uci set clawwrt."$sid".user="$user"
                    uci set clawwrt."$sid".status="unknown"
                    uci set clawwrt."$sid".frps_status="uninstalled"
                    uci set clawwrt."$sid".xkcptun_status="uninstalled"
                    uci set clawwrt."$sid".has_sudo="1"
                    uci commit clawwrt

                    json_init
                    json_add_object "result"
                    json_add_boolean "success" 1
                    json_add_string "id" "$sid"
                    json_add_string "message" "已成功添加服务器 [$name] ($host)"
                    json_close_object
                    json_dump
                    ;;
                update)
                    [ -z "$id" ] && {
                        json_init
                        json_add_object "result"
                        json_add_boolean "success" 0
                        json_add_string "message" "缺少服务器 ID"
                        json_close_object
                        json_dump
                        return
                    }
                    [ -n "$name" ] && uci set clawwrt."$id".name="$name"
                    [ -n "$host" ] && uci set clawwrt."$id".host="$host"
                    [ -n "$port" ] && uci set clawwrt."$id".port="$port"
                    [ -n "$user" ] && uci set clawwrt."$id".user="$user"
                    uci commit clawwrt

                    json_init
                    json_add_object "result"
                    json_add_boolean "success" 1
                    json_add_string "message" "已成功更新服务器配置"
                    json_close_object
                    json_dump
                    ;;
                delete)
                    [ -z "$id" ] && {
                        json_init
                        json_add_object "result"
                        json_add_boolean "success" 0
                        json_add_string "message" "缺少服务器 ID"
                        json_close_object
                        json_dump
                        return
                    }
                    uci delete clawwrt."$id" 2>/dev/null
                    uci commit clawwrt

                    json_init
                    json_add_object "result"
                    json_add_boolean "success" 1
                    json_add_string "message" "已成功从服务器池中移除该节点"
                    json_close_object
                    json_dump
                    ;;
                *)
                    json_init
                    json_add_object "result"
                    json_add_boolean "success" 0
                    json_add_string "message" "未知的管理动作: $action"
                    json_close_object
                    json_dump
                    ;;
            esac
        }

        test_vps_server() {
            read -r input
            json_load "$input"
            json_get_var id "id"
            json_get_var host "host"
            json_get_var port "port"
            json_get_var user "user"

            if [ -n "$id" ]; then
                config_load clawwrt
                config_get cfg_host "$id" host ""
                config_get cfg_port "$id" port "22"
                config_get cfg_user "$id" user "root"
                [ -n "$cfg_host" ] && host="$cfg_host"
                [ -n "$cfg_port" ] && port="$cfg_port"
                [ -n "$cfg_user" ] && user="$cfg_user"
            fi

            [ -z "$host" ] && {
                json_init
                json_add_object "result"
                json_add_boolean "connected" 0
                json_add_string "message" "缺少 VPS 主机地址"
                json_close_object
                json_dump
                return
            }

            port="${port:-22}"
            user="${user:-root}"
            local key_file="/etc/clawwrt/id_dropbear"
            if [ ! -f "$key_file" ]; then
                mkdir -p /etc/clawwrt
                dropbearkey -t ed25519 -f "$key_file" >/dev/null 2>&1
            fi

            local t_start=$(date +%s%3N 2>/dev/null || date +%s)
            local probe_cmd="echo CHAW_SSH_OK; if [ \$(id -u) -eq 0 ] || sudo -n true 2>/dev/null; then echo CHAW_PRIV_OK; else echo CHAW_NEED_SUDO; fi; if pgrep -x frps >/dev/null 2>&1; then echo CHAW_FRPS_RUNNING; elif which frps >/dev/null 2>&1 || [ -x /usr/local/bin/frps ]; then echo CHAW_FRPS_INSTALLED; fi; if pgrep -x 'xkcp_server' >/dev/null 2>&1 || pgrep -f 'server_linux' >/dev/null 2>&1; then echo CHAW_XKCP_RUNNING; elif which xkcp_server >/dev/null 2>&1 || [ -x /usr/local/bin/xkcp_server ] || which server_linux_arm64 >/dev/null 2>&1 || which server_linux_amd64 >/dev/null 2>&1 || [ -x /usr/local/bin/server_linux_amd64 ] || [ -x /usr/local/bin/server_linux_arm64 ]; then echo CHAW_XKCP_INSTALLED; fi"
            local out
            out=$(run_with_timeout 10 dbclient -y -o BatchMode=yes -i "$key_file" -p "$port" "${user}@${host}" "$probe_cmd" 2>&1)
            local ret=$?
            local t_end=$(date +%s%3N 2>/dev/null || date +%s)
            local rtt_ms=$((t_end - t_start))
            [ "$rtt_ms" -le 0 ] && rtt_ms=10

            local connected=0
            local sudo_ok=1
            local frps_stat="uninstalled"
            local xkcp_stat="uninstalled"
            local msg=""

            if [ $ret -eq 0 ] && echo "$out" | grep -q "CHAW_SSH_OK"; then
                connected=1
                if echo "$out" | grep -q "CHAW_NEED_SUDO"; then
                    sudo_ok=0
                    msg="免密连接成功（用户: ${user}），但需要密码执行 sudo。建议在服务器上执行: echo '\$USER ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/\$USER"
                else
                    msg="免密握手成功！已成功直连远程服务器，具备管理员执行权限。"
                fi

                if echo "$out" | grep -q "CHAW_FRPS_RUNNING"; then
                    frps_stat="running"
                elif echo "$out" | grep -q "CHAW_FRPS_INSTALLED"; then
                    frps_stat="installed"
                fi

                if echo "$out" | grep -q "CHAW_XKCP_RUNNING"; then
                    xkcp_stat="running"
                elif echo "$out" | grep -q "CHAW_XKCP_INSTALLED"; then
                    xkcp_stat="installed"
                fi
            else
                if echo "$out" | grep -qi "auth.*fail\|permission denied\|no auth methods"; then
                    msg="SSH 认证拒绝：公钥尚未生效，请确认公钥已正确追加至远程服务器对应用户的 ~/.ssh/authorized_keys 中。"
                elif echo "$out" | grep -qi "connection refused"; then
                    msg="连接被拒绝：目标 SSH 端口 (${port}) 未开放或端口错误。"
                elif echo "$out" | grep -qi "timed out"; then
                    msg="连接超时：无法连通 VPS (${host}:${port})，请检查云厂商安全组及防火墙。"
                else
                    msg="连接失败: ${out:-未知网络或路由错误}"
                fi
            fi

            # Update UCI if ID was specified
            if [ -n "$id" ] && uci get clawwrt."$id" >/dev/null 2>&1; then
                local now_ts=$(date "+%Y-%m-%d %H:%M:%S")
                uci set clawwrt."$id".last_check="$now_ts"
                uci set clawwrt."$id".has_sudo="$sudo_ok"
                uci set clawwrt."$id".frps_status="$frps_stat"
                uci set clawwrt."$id".xkcptun_status="$xkcp_stat"
                uci set clawwrt."$id".rtt_ms="${rtt_ms}ms"
                if [ $connected -eq 1 ]; then
                    uci set clawwrt."$id".status="connected"
                else
                    uci set clawwrt."$id".status="failed"
                fi
                uci set clawwrt."$id".message="$msg"
                uci commit clawwrt
            fi

            json_init
            json_add_object "result"
            json_add_boolean "connected" "$connected"
            json_add_boolean "sudo_ok" "$sudo_ok"
            json_add_string "frps_status" "$frps_stat"
            json_add_string "xkcptun_status" "$xkcp_stat"
            json_add_string "rtt_ms" "${rtt_ms}ms"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        test_vps_ssh() {
            read -r input
            json_load "$input"
            json_get_var vps_ip "vps_ip"
            json_get_var vps_port "vps_port"
            json_get_var vps_user "vps_user"

            [ -z "$vps_ip" ] && {
                json_init
                json_add_object "result"
                json_add_boolean "connected" 0
                json_add_string "message" "缺少 VPS IP 地址"
                json_close_object
                json_dump
                return
            }

            vps_port="${vps_port:-22}"
            vps_user="${vps_user:-root}"
            local key_file="/etc/clawwrt/id_dropbear"

            if [ ! -f "$key_file" ]; then
                mkdir -p /etc/clawwrt
                dropbearkey -t ed25519 -f "$key_file" >/dev/null 2>&1
            fi

            local out=""
            local ret=1
            # Probe SSH connectivity and check whether user has root privilege or passwordless sudo
            local probe_cmd="echo CHAW_SSH_OK; if [ \$(id -u) -eq 0 ] || sudo -n true 2>/dev/null; then echo CHAW_PRIV_OK; else echo CHAW_NEED_SUDO; fi"
            out=$(run_with_timeout 10 dbclient -y -o BatchMode=yes -i "$key_file" -p "$vps_port" "${vps_user}@${vps_ip}" "$probe_cmd" 2>&1)
            ret=$?

            local connected=0
            local sudo_ok=1
            local msg=""
            if [ $ret -eq 0 ] && echo "$out" | grep -q "CHAW_SSH_OK"; then
                connected=1
                if echo "$out" | grep -q "CHAW_NEED_SUDO"; then
                    sudo_ok=0
                    msg="免密 SSH 连接成功（用户: ${vps_user}），但检测到该用户执行 sudo 需要密码！为确保全自动部署，建议在 VPS 终端执行: echo '\$USER ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/\$USER 或改用 root 用户。"
                else
                    msg="免密 SSH 连接成功！已成功握手 VPS (用户: ${vps_user})，具备管理员权限。"
                fi
            else
                if echo "$out" | grep -qi "auth.*fail\|permission denied\|no auth methods"; then
                    msg="SSH 认证被拒绝（用户: ${vps_user}）：公钥尚未生效，请确认在 VPS 执行授权命令时的登录用户是否与此处一致。"
                elif echo "$out" | grep -qi "connection refused"; then
                    msg="连接被拒绝：VPS 上的 SSH 端口 (${vps_port}) 未开启或端口填写错误。"
                elif echo "$out" | grep -qi "timed out"; then
                    msg="连接超时：无法访问 VPS (${vps_ip}:${vps_port})，请检查安全组或防火墙。"
                else
                    msg="SSH 连接失败: ${out:-未知网络错误或连接超时}"
                fi
            fi

            json_init
            json_add_object "result"
            json_add_boolean "connected" "$connected"
            json_add_boolean "sudo_ok" "$sudo_ok"
            json_add_string "vps_user" "$vps_user"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        deploy_vps_frps() {
            read -r input
            json_load "$input"
            json_get_var vps_ip "vps_ip"
            json_get_var vps_port "vps_port"
            json_get_var vps_user "vps_user"
            json_get_var bind_port "bind_port"
            json_get_var token "token"
            json_get_var remote_web_port "remote_web_port"

            [ -z "$vps_ip" ] && {
                json_init
                json_add_object "result"
                json_add_boolean "success" 0
                json_add_string "message" "缺少 VPS IP 地址"
                json_close_object
                json_dump
                return
            }

            vps_port="${vps_port:-22}"
            vps_user="${vps_user:-root}"
            bind_port="${bind_port:-7001}"
            remote_web_port="${remote_web_port:-18000}"

            if [ -z "$token" ]; then
                token=$(hexdump -vn 16 -e '16/1 "%02x"' /dev/urandom 2>/dev/null || tr -dc 'a-zA-Z0-9' </dev/urandom | head -c 24)
            fi

            local key_file="/etc/clawwrt/id_dropbear"
            if [ ! -f "$key_file" ]; then
                mkdir -p /etc/clawwrt
                dropbearkey -t ed25519 -f "$key_file" >/dev/null 2>&1
            fi

            local remote_cmd="
set -e

# Detect privilege level: root or sudo
SUDO=''
if [ \"\$(id -u)\" -ne 0 ]; then
    if sudo -n true 2>/dev/null; then
        SUDO='sudo '
    else
        echo 'ERR_SUDO_PASSWORD_REQUIRED'
        exit 1
    fi
fi

ARCH=\$(uname -m 2>/dev/null || echo 'x86_64')
case \"\$ARCH\" in
    x86_64) FRP_ARCH='amd64' ;;
    aarch64|arm64) FRP_ARCH='arm64' ;;
    armv7l|armhf) FRP_ARCH='arm' ;;
    i386|i686) FRP_ARCH='386' ;;
    *) echo 'ERR_UNSUPPORTED_ARCH' && exit 1 ;;
esac

FRP_VER='0.61.1'
\$SUDO mkdir -p /etc/frps /opt/frps

if ! command -v frps >/dev/null 2>&1 && [ ! -x /usr/local/bin/frps ]; then
    TAR=\"frp_\${FRP_VER}_linux_\${FRP_ARCH}.tar.gz\"
    ORIGIN=\"https://github.com/fatedier/frp/releases/download/v\${FRP_VER}/\${TAR}\"
    DOWNLOADED=0
    URLS=\"\"
    if curl -sI --connect-timeout 2 https://github.com >/dev/null 2>&1 || wget -q --spider --timeout=2 https://github.com 2>/dev/null; then
        URLS=\"\${ORIGIN} https://ghfast.top/\${ORIGIN} https://gh-proxy.com/\${ORIGIN}\"
    else
        URLS=\"https://ghproxy.cn/\${ORIGIN} https://gh-proxy.com/\${ORIGIN} https://ghfast.top/\${ORIGIN} \${ORIGIN}\"
    fi

    for URL in \$URLS; do
        rm -f /tmp/frp.tar.gz
        if curl -fsSL --connect-timeout 5 -m 35 \"\$URL\" -o /tmp/frp.tar.gz 2>/dev/null || \
           wget -q --timeout=5 -T 35 -O /tmp/frp.tar.gz \"\$URL\" 2>/dev/null; then
            if tar -ztvf /tmp/frp.tar.gz >/dev/null 2>&1; then
                DOWNLOADED=1
                break
            else
                rm -f /tmp/frp.tar.gz
            fi
        fi
    done
    if [ \"\$DOWNLOADED\" -ne 1 ]; then
        echo 'ERR_DOWNLOAD_FAILED'
        exit 1
    fi
    tar -zxvf /tmp/frp.tar.gz -C /tmp/ >/dev/null 2>&1
    \$SUDO cp /tmp/frp_\${FRP_VER}_linux_\${FRP_ARCH}/frps /usr/local/bin/frps
    \$SUDO chmod +x /usr/local/bin/frps
    rm -rf /tmp/frp*
fi

[ -f /usr/local/bin/frps ] && [ ! -f /usr/bin/frps ] && \$SUDO ln -sf /usr/local/bin/frps /usr/bin/frps

\$SUDO tee /etc/frps/frps.toml >/dev/null << TOML
bindPort = ${bind_port}
auth.token = \"${token}\"
allowPorts = [
    { start = 10000, end = 30000 }
]
TOML

if [ -d /etc/systemd/system ]; then
    \$SUDO tee /etc/systemd/system/frps.service >/dev/null << SERVICE
[Unit]
Description=FRP Server Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/frps -c /etc/frps/frps.toml
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
SERVICE

    \$SUDO systemctl daemon-reload >/dev/null 2>&1 || true
    \$SUDO systemctl enable frps >/dev/null 2>&1 || true
    \$SUDO systemctl restart frps >/dev/null 2>&1 || true
else
    \$SUDO pkill -x frps 2>/dev/null || true
    nohup \$SUDO /usr/local/bin/frps -c /etc/frps/frps.toml >/var/log/frps.log 2>&1 &
fi

if command -v ufw >/dev/null 2>&1 && \$SUDO ufw status 2>/dev/null | grep -q 'active'; then
    \$SUDO ufw allow ${bind_port}/tcp >/dev/null 2>&1 || true
    \$SUDO ufw allow ${remote_web_port}/tcp >/dev/null 2>&1 || true
elif command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld 2>/dev/null; then
    \$SUDO firewall-cmd --add-port=${bind_port}/tcp --permanent >/dev/null 2>&1 || true
    \$SUDO firewall-cmd --add-port=${remote_web_port}/tcp --permanent >/dev/null 2>&1 || true
    \$SUDO firewall-cmd --reload >/dev/null 2>&1 || true
elif command -v iptables >/dev/null 2>&1; then
    \$SUDO iptables -I INPUT -p tcp --dport ${bind_port} -j ACCEPT 2>/dev/null || true
    \$SUDO iptables -I INPUT -p tcp --dport ${remote_web_port} -j ACCEPT 2>/dev/null || true
fi

sleep 1
if pgrep -x frps >/dev/null 2>&1; then
    echo 'FRPS_DEPLOY_SUCCESS'
else
    echo 'FRPS_START_FAILED'
    exit 1
fi
"

            local out=""
            local ret=1
            out=$(run_with_timeout 150 dbclient -y -o BatchMode=yes -i "$key_file" -p "$vps_port" "${vps_user}@${vps_ip}" "$remote_cmd" 2>&1)
            ret=$?

            local success=0
            local msg=""
            local web_url="http://${vps_ip}:${remote_web_port}"

            if [ $ret -eq 0 ] && echo "$out" | grep -q "FRPS_DEPLOY_SUCCESS"; then
                uci -q set xfrpc.common.enabled='1'
                uci -q set xfrpc.common.server_addr="$vps_ip"
                uci -q set xfrpc.common.server_port="$bind_port"
                uci -q set xfrpc.common.token="$token"
                uci -q set xfrpc.common.auth_method='token'
                uci -q set xfrpc.common.protocol='tcp'
                uci -q set xfrpc.common.tcp_mux='1'

                if ! uci -q get xfrpc.aw_web_tcp >/dev/null; then
                    uci -q set xfrpc.aw_web_tcp='tcp'
                fi
                uci -q set xfrpc.aw_web_tcp.enabled='1'
                uci -q set xfrpc.aw_web_tcp.local_ip='127.0.0.1'
                uci -q set xfrpc.aw_web_tcp.local_port='80'
                uci -q set xfrpc.aw_web_tcp.remote_port="$remote_web_port"

                uci commit xfrpc
                /etc/init.d/xfrpc restart >/dev/null 2>&1

                success=1
                msg="VPS 服务端 frps 部署成功，路由器客户端已自动拉通！"
            else
                success=0
                if echo "$out" | grep -q "ERR_SUDO_PASSWORD_REQUIRED"; then
                    msg="VPS 当前登录用户 (${vps_user}) 执行 sudo 需要密码，无法免交互部署服务。请在 VPS 终端执行免密提权: echo '\$USER ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/\$USER 或改用 root 用户。"
                elif echo "$out" | grep -q "ERR_DOWNLOAD_FAILED"; then
                    msg="远程 VPS 下载 frps 安装包失败或超时。提示：若 VPS 处于极端无外网隔离环境，可在 VPS 手动下载 frps 放入 /usr/local/bin/frps，系统将自动检测并跳过下载直接部署。"
                elif echo "$out" | grep -q "ERR_UNSUPPORTED_ARCH"; then
                    msg="VPS 体系架构不受支持。"
                elif echo "$out" | grep -qi "permission denied\|auth.*fail\|no auth methods"; then
                    msg="SSH 免密登录失败（用户: ${vps_user}）：公钥尚未在该用户的 ~/.ssh/authorized_keys 中生效。"
                elif echo "$out" | grep -q "FRPS_START_FAILED"; then
                    msg="frps 服务在 VPS 上启动失败，可能是端口 ${bind_port} 已被占用。"
                else
                    msg="远程部署失败: $(echo "$out" | tail -n 2 | tr '\n' ' ')"
                fi
            fi

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "vps_ip" "$vps_ip"
            json_add_string "vps_user" "$vps_user"
            json_add_string "server_port" "$bind_port"
            json_add_string "remote_web_port" "$remote_web_port"
            json_add_string "token" "$token"
            json_add_string "web_url" "$web_url"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        deploy_vps_xkcptun() {
            read -r input
            json_load "$input"
            json_get_var vps_ip "vps_ip"
            json_get_var vps_port "vps_port"
            json_get_var vps_user "vps_user"
            json_get_var listen_port "listen_port"
            json_get_var key "key"
            json_get_var mode "mode"
            json_get_var fec "fec"

            [ -z "$vps_ip" ] && {
                json_init
                json_add_object "result"
                json_add_boolean "success" 0
                json_add_string "message" "缺少 VPS IP 地址"
                json_close_object
                json_dump
                return
            }

            vps_port="${vps_port:-22}"
            vps_user="${vps_user:-root}"
            listen_port="${listen_port:-9089}"
            mode="${mode:-fast3}"
            fec="${fec:-1}"

            if [ -z "$key" ]; then
                key=$(hexdump -vn 16 -e '16/1 "%02x"' /dev/urandom 2>/dev/null || tr -dc 'a-f0-9' </dev/urandom | head -c 32)
                [ -z "$key" ] && key="7f7ac683d720e1437019692eadb0b811"
            fi

            local key_file="/etc/clawwrt/id_dropbear"
            if [ ! -f "$key_file" ]; then
                mkdir -p /etc/clawwrt
                dropbearkey -t ed25519 -f "$key_file" >/dev/null 2>&1
            fi

            local remote_cmd="
set -e
export DEBIAN_FRONTEND=noninteractive

SUDO=''
if [ \"\$(id -u)\" -ne 0 ]; then
    if sudo -n true 2>/dev/null; then
        SUDO='sudo '
    else
        echo 'ERR_SUDO_PASSWORD_REQUIRED'
        exit 1
    fi
fi

OS_ID=''
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS_ID=\"\$ID \$ID_LIKE\"
fi
case \"\$OS_ID\" in
    *ubuntu*|*debian*) ;;
    *)
        if ! command -v dpkg >/dev/null 2>&1 || ! command -v apt-get >/dev/null 2>&1; then
            echo 'ERR_NOT_UBUNTU_DEBIAN'
            exit 1
        fi
        ;;
esac

ARCH=\$(dpkg --print-architecture 2>/dev/null || uname -m)
case \"\$ARCH\" in
    amd64|x86_64) PKG_ARCH='amd64' ;;
    arm64|aarch64) PKG_ARCH='arm64' ;;
    *) PKG_ARCH='amd64' ;;
esac

XKCP_VER='1.10.566'
DEB_NAME=\"xkcptun-server_\${XKCP_VER}_\${PKG_ARCH}.deb\"
ORIGIN=\"https://github.com/liudf0716/xkcptun/releases/download/\${XKCP_VER}/\${DEB_NAME}\"

DOWNLOADED=0
URLS=\"\"
if curl -sI --connect-timeout 2 https://github.com >/dev/null 2>&1 || wget -q --spider --timeout=2 https://github.com 2>/dev/null; then
    URLS=\"\${ORIGIN} https://ghfast.top/\${ORIGIN} https://gh-proxy.com/\${ORIGIN}\"
else
    URLS=\"https://ghproxy.cn/\${ORIGIN} https://gh-proxy.com/\${ORIGIN} https://ghfast.top/\${ORIGIN} \${ORIGIN}\"
fi

for URL in \$URLS; do
    rm -f /tmp/xkcptun-server.deb
    if curl -fsSL --connect-timeout 5 -m 35 \"\$URL\" -o /tmp/xkcptun-server.deb 2>/dev/null || \
       wget -q --timeout=5 -T 35 -O /tmp/xkcptun-server.deb \"\$URL\" 2>/dev/null; then
        if [ -s /tmp/xkcptun-server.deb ]; then
            DOWNLOADED=1
            break
        fi
    fi
done

if [ \"\$DOWNLOADED\" -ne 1 ]; then
    if [ ! -x /usr/local/bin/xkcp_server ] && [ ! -x /usr/bin/xkcp_server ]; then
        echo 'ERR_DOWNLOAD_FAILED'
        exit 1
    fi
fi

if [ -f /tmp/xkcptun-server.deb ]; then
    if ! \$SUDO dpkg -i /tmp/xkcptun-server.deb >/dev/null 2>&1; then
        \$SUDO apt-get update -qq >/dev/null 2>&1 || true
        \$SUDO apt-get install -y -f -qq >/dev/null 2>&1 || true
        \$SUDO dpkg -i /tmp/xkcptun-server.deb >/dev/null 2>&1 || true
    fi
    rm -f /tmp/xkcptun-server.deb
fi

\$SUDO mkdir -p /etc/xkcptun
\$SUDO tee /etc/xkcptun/server.toml >/dev/null << TOML
[global]
syslog = true
mon_port = 9087
local_port = ${listen_port}
key = \"${key}\"
mode = \"${mode}\"
fec = ${fec}
TOML

if [ -d /etc/systemd/system ] || [ -d /lib/systemd/system ]; then
    \$SUDO systemctl daemon-reload >/dev/null 2>&1 || true
    \$SUDO systemctl enable xkcp_server >/dev/null 2>&1 || true
    \$SUDO systemctl restart xkcp_server >/dev/null 2>&1 || true
else
    \$SUDO pkill -x xkcp_server 2>/dev/null || true
    nohup \$SUDO /usr/local/bin/xkcp_server -c /etc/xkcptun/server.toml -f >/var/log/xkcp_server.log 2>&1 &
fi

if command -v ufw >/dev/null 2>&1 && \$SUDO ufw status 2>/dev/null | grep -q 'active'; then
    \$SUDO ufw allow ${listen_port}/udp >/dev/null 2>&1 || true
elif command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld 2>/dev/null; then
    \$SUDO firewall-cmd --add-port=${listen_port}/udp --permanent >/dev/null 2>&1 || true
    \$SUDO firewall-cmd --reload >/dev/null 2>&1 || true
elif command -v iptables >/dev/null 2>&1; then
    \$SUDO iptables -I INPUT -p udp --dport ${listen_port} -j ACCEPT 2>/dev/null || true
fi

sleep 1
if pgrep -x xkcp_server >/dev/null 2>&1; then
    echo 'XKCP_DEPLOY_SUCCESS'
else
    echo 'XKCP_START_FAILED'
    exit 1
fi
"

            local out=""
            local ret=1
            out=$(run_with_timeout 150 dbclient -y -o BatchMode=yes -i "$key_file" -p "$vps_port" "${vps_user}@${vps_ip}" "$remote_cmd" 2>&1)
            ret=$?

            local success=0
            local msg=""

            if [ $ret -eq 0 ] && echo "$out" | grep -q "XKCP_DEPLOY_SUCCESS"; then
                uci -q set xkcptun.client.enabled='1'
                uci -q set xkcptun.client.remote_addr="$vps_ip"
                uci -q set xkcptun.client.remote_port="$listen_port"
                uci -q set xkcptun.client.key="$key"
                uci -q set xkcptun.client.mode="$mode"
                uci -q set xkcptun.client.fec="$fec"
                uci -q set xkcptun.client.nodelay='1'
                uci -q set xkcptun.client.nc='1'
                uci commit xkcptun
                /etc/init.d/xkcptun restart >/dev/null 2>&1 || true

                for sid in $(uci -q show clawwrt | grep '=vps' | cut -d. -f2 | cut -d= -f1); do
                    local s_host=$(uci -q get clawwrt.${sid}.host)
                    if [ "$s_host" = "$vps_ip" ]; then
                        uci -q set clawwrt.${sid}.xkcptun_status="running"
                        uci -q set clawwrt.${sid}.xkcptun_port="$listen_port"
                        uci commit clawwrt
                        break
                    fi
                done

                success=1
                msg="已成功在 VPS 上通过 deb 安装并启动 xkcptun-server，路由器加速客户端已自动连通！"
            else
                success=0
                if echo "$out" | grep -q "ERR_SUDO_PASSWORD_REQUIRED"; then
                    msg="VPS 当前登录用户 (${vps_user}) 执行 sudo 需要密码，无法免交互部署 deb。请在 VPS 终端执行免密提权: echo '\$USER ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/\$USER 或改用 root 用户。"
                elif echo "$out" | grep -q "ERR_NOT_UBUNTU_DEBIAN\|ERR_NOT_DEBIAN_BASED"; then
                    msg="目标 VPS 系统不受支持。当前 xkcptun 服务端 (deb) 仅支持 Ubuntu 或 Debian 操作系统。"
                elif echo "$out" | grep -q "ERR_DOWNLOAD_FAILED"; then
                    msg="远程 VPS 从 GitHub 下载 xkcptun deb 安装包失败或超时。请检查 VPS 网络。"
                elif echo "$out" | grep -qi "permission denied\|auth.*fail\|no auth methods"; then
                    msg="SSH 免密登录失败（用户: ${vps_user}）：公钥尚未在该用户的 ~/.ssh/authorized_keys 中生效。"
                elif echo "$out" | grep -q "XKCP_START_FAILED"; then
                    msg="xkcp_server 服务在 VPS 上启动失败，可能是 UDP 端口 ${listen_port} 已被占用。"
                else
                    msg="远程部署失败: $(echo "$out" | tail -n 2 | tr '\n' ' ')"
                fi
            fi

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "vps_ip" "$vps_ip"
            json_add_string "vps_user" "$vps_user"
            json_add_string "listen_port" "$listen_port"
            json_add_string "key" "$key"
            json_add_string "mode" "$mode"
            json_add_string "fec" "$fec"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        uninstall_vps_service() {
            read -r input
            json_load "$input"
            json_get_var id "id"
            json_get_var name "name"
            json_get_var host "host"
            json_get_var port "port"
            json_get_var user "user"
            json_get_var service "service"

            service="${service:-xkcptun}"

            # If id provided, load from config
            if [ -n "$id" ]; then
                config_load clawwrt
                config_get cfg_host "$id" host ""
                config_get cfg_port "$id" port "22"
                config_get cfg_user "$id" user "root"
                config_get cfg_name "$id" name "$id"
                [ -n "$cfg_host" ] && host="$cfg_host"
                [ -n "$cfg_port" ] && port="$cfg_port"
                [ -n "$cfg_user" ] && user="$cfg_user"
                [ -n "$cfg_name" ] && name="$cfg_name"
            fi

            # If host still empty, search by name or match against all VPS entries
            if [ -z "$host" ]; then
                local search_key="${name:-$id}"
                if [ -n "$search_key" ]; then
                    for sid in $(uci -q show clawwrt | grep '=vps' | cut -d. -f2 | cut -d= -f1); do
                        local s_name=$(uci -q get clawwrt.${sid}.name)
                        local s_host=$(uci -q get clawwrt.${sid}.host)
                        if [ "$s_name" = "$search_key" ] || [ "$s_host" = "$search_key" ]; then
                            id="$sid"
                            name="$s_name"
                            host="$s_host"
                            port=$(uci -q get clawwrt.${sid}.port || echo "22")
                            user=$(uci -q get clawwrt.${sid}.user || echo "root")
                            break
                        fi
                    done
                fi
            fi

            # Fallback if search_key looks like an IP or hostname
            if [ -z "$host" ] && [ -n "$name" ]; then
                host="$name"
            fi

            [ -z "$host" ] && {
                json_init
                json_add_object "result"
                json_add_boolean "success" 0
                json_add_string "message" "未找到匹配的 VPS 或缺少主机地址"
                json_close_object
                json_dump
                return
            }

            port="${port:-22}"
            user="${user:-root}"

            local key_file="/etc/clawwrt/id_dropbear"
            if [ ! -f "$key_file" ]; then
                mkdir -p /etc/clawwrt
                dropbearkey -t ed25519 -f "$key_file" >/dev/null 2>&1
            fi

            local remote_cmd="
set -e
export DEBIAN_FRONTEND=noninteractive

SUDO=''
if [ \"\$(id -u)\" -ne 0 ]; then
    if sudo -n true 2>/dev/null; then
        SUDO='sudo '
    else
        echo 'ERR_SUDO_PASSWORD_REQUIRED'
        exit 1
    fi
fi
"

            if [ "$service" = "xkcptun" ] || [ "$service" = "all" ]; then
                remote_cmd="${remote_cmd}
if command -v systemctl >/dev/null 2>&1; then
    \$SUDO systemctl stop xkcp_server 2>/dev/null || true
    \$SUDO systemctl disable xkcp_server 2>/dev/null || true
    \$SUDO systemctl stop xkcptun-server 2>/dev/null || true
    \$SUDO systemctl disable xkcptun-server 2>/dev/null || true
    \$SUDO rm -f /etc/systemd/system/xkcp_server.service /lib/systemd/system/xkcp_server.service /etc/systemd/system/xkcptun-server.service /lib/systemd/system/xkcptun-server.service 2>/dev/null || true
    \$SUDO systemctl daemon-reload 2>/dev/null || true
fi
\$SUDO pkill -9 -x xkcp_server 2>/dev/null || true
\$SUDO pkill -9 -f server_linux 2>/dev/null || true
if command -v dpkg >/dev/null 2>&1; then
    if dpkg -s xkcptun-server >/dev/null 2>&1; then
        \$SUDO dpkg -P xkcptun-server 2>/dev/null || \$SUDO dpkg -r xkcptun-server 2>/dev/null || true
    fi
fi
\$SUDO rm -rf /etc/xkcptun 2>/dev/null || true
\$SUDO rm -f /usr/local/bin/xkcp_server /usr/local/bin/server_linux_* 2>/dev/null || true
if command -v ufw >/dev/null 2>&1 && \$SUDO ufw status 2>/dev/null | grep -q 'active'; then
    \$SUDO ufw delete allow 9089/udp 2>/dev/null || true
fi
echo 'XKCPTUN_UNINSTALL_OK'
"
            fi

            if [ "$service" = "frps" ] || [ "$service" = "all" ]; then
                remote_cmd="${remote_cmd}
if command -v systemctl >/dev/null 2>&1; then
    \$SUDO systemctl stop frps 2>/dev/null || true
    \$SUDO systemctl disable frps 2>/dev/null || true
    \$SUDO rm -f /etc/systemd/system/frps.service 2>/dev/null || true
    \$SUDO systemctl daemon-reload 2>/dev/null || true
fi
\$SUDO pkill -9 -x frps 2>/dev/null || true
\$SUDO rm -rf /etc/frps /var/log/frps.log 2>/dev/null || true
\$SUDO rm -f /usr/local/bin/frps 2>/dev/null || true
echo 'FRPS_UNINSTALL_OK'
"
            fi

            local out=""
            local ret=1
            out=$(run_with_timeout 15 dbclient -y -o BatchMode=yes -i "$key_file" -p "$port" "${user}@${host}" "$remote_cmd" 2>&1)
            ret=$?

            local success=0
            local msg=""

            if [ $ret -eq 0 ]; then
                success=1
                # Router local cleanup
                if [ "$service" = "xkcptun" ] || [ "$service" = "all" ]; then
                    local cur_remote=$(uci -q get xkcptun.client.remote_addr)
                    if [ "$cur_remote" = "$host" ]; then
                        uci -q set xkcptun.client.enabled='0'
                        uci commit xkcptun 2>/dev/null
                        /etc/init.d/xkcptun stop >/dev/null 2>&1 || true
                    fi
                fi
                if [ "$service" = "frps" ] || [ "$service" = "all" ]; then
                    local cur_srv=$(uci -q get xfrpc.common.server_addr)
                    if [ "$cur_srv" = "$host" ]; then
                        uci -q set xfrpc.common.enabled='0'
                        uci commit xfrpc 2>/dev/null
                        /etc/init.d/xfrpc stop >/dev/null 2>&1 || true
                    fi
                fi

                # Update VPS registry status
                for sid in $(uci -q show clawwrt | grep '=vps' | cut -d. -f2 | cut -d= -f1); do
                    local s_host=$(uci -q get clawwrt.${sid}.host)
                    if [ "$s_host" = "$host" ]; then
                        if [ "$service" = "xkcptun" ] || [ "$service" = "all" ]; then
                            uci -q set clawwrt.${sid}.xkcptun_status="uninstalled"
                        fi
                        if [ "$service" = "frps" ] || [ "$service" = "all" ]; then
                            uci -q set clawwrt.${sid}.frps_status="uninstalled"
                        fi
                        uci commit clawwrt 2>/dev/null
                        break
                    fi
                done

                msg="已成功在 VPS [${name:-$host}] 上停止并彻底卸载 ${service} 服务端，路由器本地客户端已自动同步停用！"
            else
                success=0
                if echo "$out" | grep -q "ERR_SUDO_PASSWORD_REQUIRED"; then
                    msg="VPS 用户 (${user}) 执行 sudo 需要密码，无法免交互卸载服务。"
                elif echo "$out" | grep -qi "permission denied\|auth.*fail\|no auth methods"; then
                    msg="SSH 认证失败：公钥尚未在 VPS 的 ~/.ssh/authorized_keys 中生效。"
                elif echo "$out" | grep -qi "timeout\|timed out"; then
                    msg="SSH 连接 VPS 超时，请检查 VPS IP 与端口是否可达。"
                else
                    msg="远程卸载失败: $(echo "$out" | tail -n 2 | tr '\n' ' ')"
                fi
            fi

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "service" "$service"
            json_add_string "host" "$host"
            json_add_string "name" "$name"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        get_penetration_status() {
            local enabled=$(uci -q get xfrpc.common.enabled || echo 0)
            local server_addr=$(uci -q get xfrpc.common.server_addr)
            local server_port=$(uci -q get xfrpc.common.server_port || echo 7001)
            local protocol=$(uci -q get xfrpc.common.protocol || echo tcp)
            local pid=$(pidof xfrpc 2>/dev/null)
            local run=0
            [ -n "$pid" ] && run=1

            local sock_line=$(netstat -ntp 2>/dev/null | grep "[0-9]*/xfrpc" | grep ":${server_port} " | head -n1)
            [ -z "$sock_line" ] && sock_line=$(netstat -ntp 2>/dev/null | grep "[0-9]*/xfrpc" | head -n1)

            local sock_state="NONE"
            local local_ep=""
            local remote_ep=""
            if [ -n "$sock_line" ]; then
                local_ep=$(echo "$sock_line" | awk '{print $4}')
                remote_ep=$(echo "$sock_line" | awk '{print $5}')
                sock_state=$(echo "$sock_line" | awk '{print $6}')
            fi

            local connected=0
            [ "$sock_state" = "ESTABLISHED" ] && connected=1

            local last_err=""
            local recent_logs=""
            if command -v logread >/dev/null 2>&1; then
                recent_logs=$(logread 2>/dev/null | grep -i "xfrpc" | tail -n 8)
                if echo "$recent_logs" | grep -qi "failed\|timed out\|refused\|disconnect\|error"; then
                    last_err=$(echo "$recent_logs" | grep -Ei "failed|timed out|refused|disconnect|error" | tail -n1 | sed "s/.*xfrpc\[[0-9]*\]: //")
                fi
            fi

            local status="stopped"
            local diagnosis=""
            if [ "$run" -eq 1 ]; then
                if [ "$connected" -eq 1 ]; then
                    status="connected"
                    diagnosis="xfrpc 客户端运行正常，且已成功与远端 frps 服务端 ($server_addr:$server_port) 建立稳定连接 (ESTABLISHED)，内网穿透隧道生效中。"
                elif [ "$sock_state" = "SYN_SENT" ]; then
                    status="connecting_timeout"
                    diagnosis="xfrpc 客户端正在运行，但与远端 frps 服务端 ($server_addr:$server_port) 处于握手连接超时状态 (SYN_SENT)。可能原因：1. VPS 上的 frps 未启动；2. VPS 防火墙或云控制台安全组未放行端口 $server_port；3. VPS IP 地址填写错误。"
                elif echo "$last_err" | grep -qi "refused"; then
                    status="connection_refused"
                    diagnosis="xfrpc 客户端正在运行，但连接被 VPS 拒绝（Connection refused）。VPS 上的端口未被监听，请检查 frps 服务是否正常运行。"
                elif echo "$last_err" | grep -qi "token\|auth"; then
                    status="auth_failed"
                    diagnosis="xfrpc 客户端正在运行，但认证失败。请检查路由器与 VPS 服务端的认证 Token 是否一致。"
                else
                    status="disconnected"
                    diagnosis="xfrpc 客户端正在运行，但尚未与远端 frps 建立连接 (当前套接字: ${sock_state:-无活跃连接})。${last_err:+最新日志: $last_err}"
                fi
            else
                status="stopped"
                diagnosis="xfrpc 客户端未运行。请先开启内网穿透服务。"
            fi

            local is_enabled=0
            [ "$enabled" = "1" ] && is_enabled=1

            json_init
            json_add_object "result"
            json_add_string "service" "xfrpc"
            json_add_boolean "enabled" "$is_enabled"
            json_add_boolean "running" "$run"
            json_add_boolean "connected_to_frps" "$connected"
            json_add_string "status" "$status"
            json_add_string "server_addr" "$server_addr"
            json_add_string "server_port" "$server_port"
            json_add_string "protocol" "$protocol"
            json_add_string "pid" "${pid:-none}"
            json_add_string "socket_state" "$sock_state"
            json_add_string "local_endpoint" "$local_ep"
            json_add_string "remote_endpoint" "$remote_ep"
            json_add_string "last_error" "$last_err"
            json_add_string "diagnosis" "$diagnosis"

            json_add_array "proxies"
            for sec in $(uci -q show xfrpc | grep -E "=(tcp|http|https|udp|socks5|stcp|xtcp|sudp|tcpmux)" | cut -d. -f2 | cut -d= -f1); do
                local type=$(uci -q get xfrpc.${sec})
                local penabled=$(uci -q get xfrpc.${sec}.enabled || echo 1)
                local lip=$(uci -q get xfrpc.${sec}.local_ip)
                local lport=$(uci -q get xfrpc.${sec}.local_port)
                local rport=$(uci -q get xfrpc.${sec}.remote_port)
                local subdomain=$(uci -q get xfrpc.${sec}.subdomain)
                local custom_domains=$(uci -q get xfrpc.${sec}.custom_domains)
                local use_enc=$(uci -q get xfrpc.${sec}.use_encryption || echo 0)
                local use_comp=$(uci -q get xfrpc.${sec}.use_compression || echo 0)
                local is_p_en=0
                [ "$penabled" = "1" ] && is_p_en=1

                local access_url=""
                if [ "$type" = "tcp" ] && [ -n "$rport" ] && [ -n "$server_addr" ]; then
                    access_url="tcp://${server_addr}:${rport}"
                elif [ "$type" = "udp" ] && [ -n "$rport" ] && [ -n "$server_addr" ]; then
                    access_url="udp://${server_addr}:${rport}"
                elif [ "$type" = "socks5" ] && [ -n "$rport" ] && [ -n "$server_addr" ]; then
                    access_url="socks5://${server_addr}:${rport}"
                elif [ "$type" = "http" ] || [ "$type" = "https" ]; then
                    if [ -n "$custom_domains" ]; then
                        access_url="${type}://${custom_domains%% *}"
                    elif [ -n "$subdomain" ]; then
                        access_url="${type}://${subdomain}.${server_addr}"
                    fi
                fi

                json_add_object
                json_add_string "name" "$sec"
                json_add_string "type" "$type"
                json_add_boolean "enabled" "$is_p_en"
                json_add_string "local_target" "${lip:+${lip}:}${lport}"
                json_add_string "remote_port" "$rport"
                json_add_string "subdomain" "$subdomain"
                json_add_string "custom_domains" "$custom_domains"
                json_add_boolean "use_encryption" "$([ "$use_enc" = "1" ] && echo 1 || echo 0)"
                json_add_boolean "use_compression" "$([ "$use_comp" = "1" ] && echo 1 || echo 0)"
                json_add_string "access_url" "$access_url"
                json_close_object
            done
            json_close_array

            json_close_object
            json_dump
        }

        manage_xdns_domain() {
            read -r input
            json_load "$input"
            json_get_var action "action"
            json_get_var domain "domain"

            local domains_file=$(uci -q get xdns.global.proxy_domains_file || echo "/etc/xdns/proxy_domains.txt")
            local success=0
            local msg=""

            case "$action" in
                list)
                    json_init
                    json_add_object "result"
                    json_add_string "status" "success"
                    json_add_boolean "success" "1"
                    json_add_string "action" "list"
                    json_add_array "domains"
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local ctl_domains=$(/usr/bin/xdns-ctl list-domains 2>/dev/null | grep -E '\s+Active\s*$' || true)
                        while read -r dline; do
                            [ -z "$dline" ] && continue
                            local dname=$(echo "$dline" | awk '{print $1}')
                            local dhash=$(echo "$dline" | awk '{print $2}')
                            local dstate=$(echo "$dline" | awk '{print $3}')
                            [ -z "$dname" ] || [ "$dname" = "Domain" ] && continue
                            json_add_object ""
                            json_add_string "domain" "$dname"
                            json_add_string "hash" "$dhash"
                            json_add_string "state" "$dstate"
                            json_close_object
                        done <<EOF
$ctl_domains
EOF
                    elif [ -f "$domains_file" ]; then
                        for d in $(grep -v '^[[:space:]]*#' "$domains_file" | grep -v '^[[:space:]]*$'); do
                            json_add_object ""
                            json_add_string "domain" "$d"
                            json_add_string "state" "Configured"
                            json_close_object
                        done
                    fi
                    json_close_array
                    local total=$(grep -v '^[[:space:]]*#' "$domains_file" 2>/dev/null | grep -v '^[[:space:]]*$' | wc -l)
                    json_add_int "total_count" "${total:-0}"
                    json_close_object
                    json_dump
                    return
                    ;;
                add)
                    if [ -z "$domain" ]; then
                        msg="域名不能为空"
                    elif command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local out=$(/usr/bin/xdns-ctl add-domain "$domain" 2>&1)
                        success=1
                        msg="已成功将域名 [$domain] 添加至内核 eBPF 智能分流加速表及持久化配置文件，已立即生效"
                    else
                        [ -f "$domains_file" ] && echo "$domain" >> "$domains_file"
                        success=1
                        msg="已将域名 [$domain] 追加至分流列表"
                    fi
                    ;;
                remove|del)
                    if [ -z "$domain" ]; then
                        msg="域名不能为空"
                    elif command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local out=$(/usr/bin/xdns-ctl del-domain "$domain" 2>&1)
                        success=1
                        msg="已成功从内核 eBPF 智能分流表中移除域名 [$domain]，已立即生效"
                    else
                        [ -f "$domains_file" ] && sed -i "/^${domain}$/d" "$domains_file"
                        success=1
                        msg="已从分流列表中删除域名 [$domain]"
                    fi
                    ;;
                clear_ips|flush)
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local out=$(/usr/bin/xdns-ctl clear-ips 2>&1)
                        success=1
                        msg="已成功清空内核 eBPF 动态劫持加速 IP 集合缓存 ($out)"
                    else
                        msg="未找到 xdns-ctl 管理命令"
                    fi
                    ;;
                reload)
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local out=$(/usr/bin/xdns-ctl reload-domains 2>&1)
                        success=1
                        msg="已成功将持久化域名规则全量重载至内核，并清空历史 IP 缓存 ($out)"
                    else
                        msg="未找到 xdns-ctl 管理命令"
                    fi
                    ;;
                list_ips)
                    json_init
                    json_add_object "result"
                    json_add_string "status" "success"
                    json_add_boolean "success" "1"
                    json_add_string "action" "list_ips"
                    json_add_array "ips"
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local ctl_ips=$(/usr/bin/xdns-ctl list-ips 2>/dev/null | grep -E '^[0-9]')
                        while read -r ipline; do
                            [ -z "$ipline" ] && continue
                            local ip_addr=$(echo "$ipline" | awk '{print $1}')
                            local exp_time=$(echo "$ipline" | awk '{print $2}')
                            json_add_object ""
                            json_add_string "ip" "$ip_addr"
                            json_add_string "expires_in" "$exp_time"
                            json_close_object
                        done <<EOF
$ctl_ips
EOF
                    fi
                    json_close_array
                    local total_ips=$(/usr/bin/xdns-ctl list-ips 2>/dev/null | grep -E '^[0-9]' | wc -l)
                    json_add_int "total_ips" "${total_ips:-0}"
                    json_close_object
                    json_dump
                    return
                    ;;
                list_sessions)
                    json_init
                    json_add_object "result"
                    json_add_string "status" "success"
                    json_add_boolean "success" "1"
                    json_add_string "action" "list_sessions"
                    json_add_array "sessions"
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local ctl_sessions=$(/usr/bin/xdns-ctl list-sessions 2>/dev/null | grep -E '^[0-9]')
                        while read -r sline; do
                            [ -z "$sline" ] && continue
                            local client_ep=$(echo "$sline" | awk '{print $1}')
                            local target_ep=$(echo "$sline" | awk '{print $2}')
                            local last_seen=$(echo "$sline" | awk '{$1=""; $2=""; print $0}' | sed 's/^[[:space:]]*//')
                            json_add_object ""
                            json_add_string "client" "$client_ep"
                            json_add_string "target" "$target_ep"
                            json_add_string "last_seen" "$last_seen"
                            json_close_object
                        done <<EOF
$ctl_sessions
EOF
                    fi
                    json_close_array
                    local total_sessions=$(/usr/bin/xdns-ctl list-sessions 2>/dev/null | grep -E '^[0-9]' | wc -l)
                    json_add_int "total_sessions" "${total_sessions:-0}"
                    json_close_object
                    json_dump
                    return
                    ;;
                stats)
                    local ctl_stats=$(/usr/bin/xdns-ctl stats 2>/dev/null)
                    json_init
                    json_add_object "result"
                    json_add_string "status" "success"
                    json_add_boolean "success" "1"
                    json_add_string "action" "stats"
                    json_add_int "dns_queries_intercepted" "$(echo "$ctl_stats" | grep "DNS Queries Intercepted" | awk '{print $NF}' || echo 0)"
                    json_add_int "dns_queries_proxied" "$(echo "$ctl_stats" | grep "DNS Queries Proxied" | awk '{print $NF}' || echo 0)"
                    json_add_int "dns_responses_learned" "$(echo "$ctl_stats" | grep "DNS Responses Learned" | awk '{print $NF}' || echo 0)"
                    json_add_int "tcp_connections_proxied" "$(echo "$ctl_stats" | grep "TCP Connections Proxied" | awk '{print $NF}' || echo 0)"
                    json_close_object
                    json_dump
                    return
                    ;;
                *)
                    msg="未知的操作动作: $action (支持: list, add, remove, clear_ips, reload, list_ips, list_sessions, stats)"
                    ;;
            esac

            local total=$(grep -v '^[[:space:]]*#' "$domains_file" 2>/dev/null | grep -v '^[[:space:]]*$' | wc -l)
            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "action" "$action"
            json_add_string "domain" "$domain"
            json_add_string "message" "$msg"
            json_add_int "total_domains" "${total:-0}"
            json_close_object
            json_dump
        }

        manage_portal_access() {
            read -r input
            json_load "$input"
            json_get_var action "action"
            json_get_var mac "mac"
            json_get_var domain "domain"
            json_get_var target "target"
            json_get_var feature "feature"
            json_get_var value "value"

            # 智能映射与规范化
            [ -z "$mac" ] && [ -n "$target" ] && echo "$target" | grep -E -q '^([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}$' && mac="$target"
            [ -n "$mac" ] && mac=$(echo "$mac" | tr 'A-Z' 'a-z' | tr '-' ':')
            [ -z "$domain" ] && [ -n "$target" ] && echo "$target" | grep -v ':' | grep -q '\.' && domain="$target"
            [ -n "$domain" ] && domain=$(echo "$domain" | tr 'A-Z' 'a-z' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

            local success=0
            local msg=""

            case "$action" in
                list)
                    json_init
                    json_add_object "result"
                    json_add_boolean "success" "1"
                    json_add_string "action" "list"
                    json_add_string "status" "success"

                    json_add_array "trusted_macs"
                    for m in $(uci -q get wifidogx.common.trusted_macs); do
                        json_add_string "" "$m"
                    done
                    json_close_array

                    json_add_array "untrusted_macs"
                    for m in $(uci -q get wifidogx.common.untrust_macs); do
                        json_add_string "" "$m"
                    done
                    json_close_array

                    json_add_array "trusted_domains"
                    for d in $(uci -q get wifidogx.common.trusted_domains); do
                        json_add_string "" "$d"
                    done
                    json_close_array

                    json_add_array "trusted_wildcard_domains"
                    for wd in $(uci -q get wifidogx.common.trusted_wildcard_domains); do
                        json_add_string "" "$wd"
                    done
                    json_close_array

                    json_add_array "online_users"
                    local ujson=$(/usr/bin/wdctlx apfree user_list 2>/dev/null)
                    if [ -n "$ujson" ]; then
                        local users_raw=$(echo "$ujson" | jsonfilter -e '@["online user"][*]' 2>/dev/null)
                        while read -r uline; do
                            [ -z "$uline" ] && continue
                            local um=$(echo "$uline" | jsonfilter -e '@.mac' 2>/dev/null)
                            local rem=$(echo "$uline" | jsonfilter -e '@["remaining time"]' 2>/dev/null)
                            [ -z "$um" ] && continue
                            [ -z "$rem" ] && rem=0
                            local uip=""
                            local uhost=""
                            if [ -f /tmp/dhcp.leases ]; then
                                local lease_line=$(grep -i "$um" /tmp/dhcp.leases | head -n1)
                                uip=$(echo "$lease_line" | awk '{print $3}')
                                uhost=$(echo "$lease_line" | awk '{print $4}')
                                [ "$uhost" = "*" ] && uhost=""
                            fi
                            json_add_object ""
                            json_add_string "mac" "$um"
                            json_add_string "ip" "${uip:-未知}"
                            json_add_string "hostname" "${uhost:-未知设备}"
                            json_add_int "remaining_seconds" "$rem"
                            json_close_object
                        done <<EOF
$users_raw
EOF
                    fi
                    json_close_array

                    json_add_string "disable_portal_auth" "$(uci -q get wifidogx.common.disable_portal_auth || echo 0)"
                    json_add_string "wired_passed" "$(uci -q get wifidogx.common.wired_passed || echo 0)"
                    json_add_string "enable_anti_nat" "$(uci -q get wifidogx.common.enable_anti_nat || echo 0)"
                    json_close_object
                    json_dump
                    return
                    ;;

                add_whitelist|add_white|add)
                    if [ -z "$mac" ]; then
                        msg="MAC 地址不能为空"
                    elif ! echo "$mac" | grep -E -q '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
                        msg="MAC 地址格式不正确 (应形如: aa:bb:cc:dd:ee:ff)"
                    else
                        uci del_list wifidogx.common.untrust_macs="$mac" 2>/dev/null
                        /usr/bin/wdctlx blacklist mac del "$mac" >/dev/null 2>&1

                        if ! uci -q get wifidogx.common.trusted_macs | grep -qi "$mac"; then
                            uci add_list wifidogx.common.trusted_macs="$mac"
                            uci commit wifidogx
                        fi
                        /usr/bin/wdctlx add mac "$mac" >/dev/null 2>&1
                        success=1
                        msg="已成功将终端 MAC [$mac] 加入免认证白名单，该设备现在无需登录即可直接上网"
                    fi
                    ;;

                del_whitelist|del_white|remove_white|remove|del)
                    if [ -z "$mac" ]; then
                        msg="MAC 地址不能为空"
                    else
                        uci del_list wifidogx.common.trusted_macs="$mac"
                        uci commit wifidogx
                        /usr/bin/wdctlx del mac "$mac" >/dev/null 2>&1
                        success=1
                        msg="已成功将终端 MAC [$mac] 从免认证白名单中移除"
                    fi
                    ;;

                add_blacklist|add_black)
                    if [ -z "$mac" ]; then
                        msg="MAC 地址不能为空"
                    elif ! echo "$mac" | grep -E -q '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
                        msg="MAC 地址格式不正确 (应形如: aa:bb:cc:dd:ee:ff)"
                    else
                        uci del_list wifidogx.common.trusted_macs="$mac" 2>/dev/null
                        /usr/bin/wdctlx del mac "$mac" >/dev/null 2>&1

                        if ! uci -q get wifidogx.common.untrust_macs | grep -qi "$mac"; then
                            uci add_list wifidogx.common.untrust_macs="$mac"
                            uci commit wifidogx
                        fi
                        /usr/bin/wdctlx blacklist mac add "$mac" >/dev/null 2>&1
                        /usr/bin/wdctlx reset "$mac" >/dev/null 2>&1
                        success=1
                        msg="已成功将终端 MAC [$mac] 加入门户黑名单并即时强制踢下线，该终端已被防火墙阻断！"
                    fi
                    ;;

                del_blacklist|del_black|remove_black)
                    if [ -z "$mac" ]; then
                        msg="MAC 地址不能为空"
                    else
                        uci del_list wifidogx.common.untrust_macs="$mac"
                        uci commit wifidogx
                        /usr/bin/wdctlx blacklist mac del "$mac" >/dev/null 2>&1
                        success=1
                        msg="已成功将终端 MAC [$mac] 从黑名单中移除"
                    fi
                    ;;

                kick_client|kick|reset)
                    local kick_target="${target:-$mac}"
                    if [ -z "$kick_target" ]; then
                        msg="踢下线目标不能为空 (请输入终端 MAC 或 IP 地址)"
                    else
                        local res=$(/usr/bin/wdctlx reset "$kick_target" 2>/dev/null)
                        success=1
                        msg="已成功强制将终端 [$kick_target] 踢下线并清除认证会话，该设备已被防火墙即时阻断，需重新完成网页认证方可上网。"
                    fi
                    ;;

                add_domain)
                    if [ -z "$domain" ]; then
                        msg="域名不能为空"
                    else
                        if echo "$domain" | grep -q '^\*\.'; then
                            if ! uci -q get wifidogx.common.trusted_wildcard_domains | grep -qi "$domain"; then
                                uci add_list wifidogx.common.trusted_wildcard_domains="$domain"
                                uci commit wifidogx
                            fi
                            /usr/bin/wdctlx add wildcard_domain "$domain" >/dev/null 2>&1
                            success=1
                            msg="已成功将通配符域名 [$domain] 加入门户免认证信任名单，所有该主域下的网站无需登录即可免认证访问"
                        else
                            if ! uci -q get wifidogx.common.trusted_domains | grep -qi "$domain"; then
                                uci add_list wifidogx.common.trusted_domains="$domain"
                                uci commit wifidogx
                            fi
                            /usr/bin/wdctlx add domain "$domain" >/dev/null 2>&1
                            success=1
                            msg="已成功将域名 [$domain] 加入门户免认证信任名单，该网站无需登录即可免认证访问"
                        fi
                    fi
                    ;;

                del_domain|remove_domain)
                    if [ -z "$domain" ]; then
                        msg="域名不能为空"
                    else
                        if echo "$domain" | grep -q '^\*\.'; then
                            uci del_list wifidogx.common.trusted_wildcard_domains="$domain"
                            uci commit wifidogx
                            /usr/bin/wdctlx del wildcard_domain "$domain" >/dev/null 2>&1
                            success=1
                            msg="已成功从免认证名单中移除通配符域名 [$domain]"
                        else
                            uci del_list wifidogx.common.trusted_domains="$domain"
                            uci commit wifidogx
                            /usr/bin/wdctlx del domain "$domain" >/dev/null 2>&1
                            success=1
                            msg="已成功从免认证名单中移除域名 [$domain]"
                        fi
                    fi
                    ;;

                set_feature)
                    if [ "$feature" = "disable_portal_auth" ] || [ "$feature" = "wired_passed" ] || [ "$feature" = "enable_anti_nat" ]; then
                        uci set "wifidogx.common.${feature}=${value}"
                        uci commit wifidogx
                        /etc/init.d/wifidogx restart >/dev/null 2>&1
                        success=1
                        msg="已成功更新门户功能参数 [${feature} = ${value}] 并重启生效"
                    else
                        msg="未知的功能参数: $feature"
                    fi
                    ;;

                *)
                    msg="未知的门户操作动作: $action"
                    ;;
            esac

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "action" "$action"
            json_add_string "message" "$msg"
            json_add_array "current_whitelist"
            for m in $(uci -q get wifidogx.common.trusted_macs); do
                json_add_string "" "$m"
            done
            json_close_array
            json_add_array "current_blacklist"
            for m in $(uci -q get wifidogx.common.untrust_macs); do
                json_add_string "" "$m"
            done
            json_close_array
            json_close_object
            json_dump
        }

        manage_portal_whitelist() {
            manage_portal_access
        }

        manage_penetration_proxy() {
            read -r input
            json_load "$input"
            json_get_var action "action"
            json_get_var rule_name "rule_name"
            json_get_var proxy_type "proxy_type"
            json_get_var local_ip "local_ip"
            json_get_var local_port "local_port"
            json_get_var remote_port "remote_port"
            json_get_var subdomain "subdomain"
            json_get_var custom_domains "custom_domains"
            json_get_var use_encryption "use_encryption"
            json_get_var use_compression "use_compression"

            local success=0
            local msg=""

            case "$action" in
                list)
                    get_penetration_status
                    return
                    ;;
                add|set)
                    if [ -z "$rule_name" ]; then
                        msg="规则名称 (rule_name) 不能为空"
                    elif [ -z "$local_port" ] && [ "$proxy_type" != "socks5" ]; then
                        msg="本地端口 (local_port) 不能为空"
                    else
                        [ -z "$proxy_type" ] && proxy_type="tcp"
                        [ -z "$local_ip" ] && local_ip="127.0.0.1"

                        uci -q set xfrpc.${rule_name}="${proxy_type}"
                        uci -q set xfrpc.${rule_name}.enabled="1"
                        [ -n "$local_ip" ] && uci -q set xfrpc.${rule_name}.local_ip="${local_ip}"
                        [ -n "$local_port" ] && uci -q set xfrpc.${rule_name}.local_port="${local_port}"
                        [ -n "$remote_port" ] && uci -q set xfrpc.${rule_name}.remote_port="${remote_port}"
                        [ -n "$subdomain" ] && uci -q set xfrpc.${rule_name}.subdomain="${subdomain}"
                        [ -n "$custom_domains" ] && uci -q set xfrpc.${rule_name}.custom_domains="${custom_domains}"
                        if [ -n "$use_encryption" ]; then
                            uci -q set xfrpc.${rule_name}.use_encryption="$([ "$use_encryption" = "1" -o "$use_encryption" = "true" ] && echo 1 || echo 0)"
                        fi
                        if [ -n "$use_compression" ]; then
                            uci -q set xfrpc.${rule_name}.use_compression="$([ "$use_compression" = "1" -o "$use_compression" = "true" ] && echo 1 || echo 0)"
                        fi
                        uci commit xfrpc
                        /etc/init.d/xfrpc restart >/dev/null 2>&1
                        success=1
                        local target_desc="${remote_port:+远程端口 $remote_port}${subdomain:+子域名 $subdomain}${custom_domains:+自定义域名 $custom_domains}"
                        msg="已成功创建/更新内网穿透规则 [${rule_name}] (${proxy_type}: ${local_ip}:${local_port} -> ${target_desc:-目标已设定})，服务已重启生效"
                    fi
                    ;;
                enable)
                    if [ -z "$rule_name" ]; then
                        msg="规则名称 (rule_name) 不能为空"
                    elif [ -z "$(uci -q get xfrpc.${rule_name})" ]; then
                        msg="未找到名称为 [${rule_name}] 的穿透规则"
                    else
                        uci -q set xfrpc.${rule_name}.enabled="1"
                        uci commit xfrpc
                        /etc/init.d/xfrpc restart >/dev/null 2>&1
                        success=1
                        msg="已成功启用内网穿透规则 [${rule_name}]，服务已重启生效"
                    fi
                    ;;
                disable)
                    if [ -z "$rule_name" ]; then
                        msg="规则名称 (rule_name) 不能为空"
                    elif [ -z "$(uci -q get xfrpc.${rule_name})" ]; then
                        msg="未找到名称为 [${rule_name}] 的穿透规则"
                    else
                        uci -q set xfrpc.${rule_name}.enabled="0"
                        uci commit xfrpc
                        /etc/init.d/xfrpc restart >/dev/null 2>&1
                        success=1
                        msg="已成功停用/禁用内网穿透规则 [${rule_name}]，服务已重启生效"
                    fi
                    ;;
                remove|del|delete)
                    if [ -z "$rule_name" ]; then
                        msg="规则名称 (rule_name) 不能为空"
                    elif [ -z "$(uci -q get xfrpc.${rule_name})" ]; then
                        msg="未找到名称为 [${rule_name}] 的穿透规则"
                    else
                        uci -q delete xfrpc.${rule_name}
                        uci commit xfrpc
                        /etc/init.d/xfrpc restart >/dev/null 2>&1
                        success=1
                        msg="已成功删除内网穿透规则 [${rule_name}]，服务已重启生效"
                    fi
                    ;;
                *)
                    msg="未知的操作动作: $action (支持: list, add, remove, enable, disable)"
                    ;;
            esac

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "action" "$action"
            json_add_string "rule_name" "$rule_name"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        manage_xkcptun_tunnel() {
            read -r input
            json_load "$input"
            json_get_var action "action"
            json_get_var tunnel_name "tunnel_name"
            json_get_var proto "proto"
            json_get_var proxy_type "proxy_type"
            json_get_var local_port "local_port"
            json_get_var local_interface "local_interface"
            json_get_var target_addr "target_addr"
            json_get_var target_port "target_port"
            json_get_var enabled "enabled"

            local success=0
            local msg=""

            case "$action" in
                list)
                    local mon_raw=$(wget -qO- -T 1 http://127.0.0.1:9086 2>/dev/null)
                    json_init
                    json_add_object "result"
                    json_add_string "status" "success"
                    json_add_boolean "success" "1"
                    json_add_string "action" "list"
                    json_add_array "tunnels"
                    local total_t=0
                    local active_t=0
                    for sec in $(uci -q show xkcptun | grep '=client$' | cut -d. -f2 | cut -d= -f1); do
                        local t_name="$sec"
                        local t_en=$(uci -q get xkcptun.${sec}.enabled || echo 1)
                        local t_proto=$(uci -q get xkcptun.${sec}.proto || echo tcp)
                        local t_type=$(uci -q get xkcptun.${sec}.proxy_type)
                        [ -z "$t_type" ] && { [ "$t_proto" = "udp" ] && t_type="forward" || t_type="redir"; }
                        local t_lport=$(uci -q get xkcptun.${sec}.local_port)
                        local t_lif=$(uci -q get xkcptun.${sec}.local_interface || echo any)
                        local t_target_addr=$(uci -q get xkcptun.${sec}.target_addr)
                        local t_target_port=$(uci -q get xkcptun.${sec}.target_port)
                        local t_conns=0
                        if [ -n "$mon_raw" ]; then
                            t_conns=$(echo "$mon_raw" | grep "\[${t_name}\]" | sed -n 's/.*conns: \([0-9]*\).*/\1/p' | head -n1)
                            [ -z "$t_conns" ] && t_conns=0
                        fi
                        if [ "$t_type" = "redir" ] && [ -n "$t_lport" ]; then
                            local est=$(netstat -nt 2>/dev/null | grep ":${t_lport} " | grep -c "ESTABLISHED" || echo 0)
                            [ "${est:-0}" -gt "${t_conns:-0}" ] && t_conns="$est"
                        fi
                        total_t=$((total_t + 1))
                        [ "$t_en" = "1" ] && active_t=$((active_t + 1))

                        json_add_object ""
                        json_add_string "name" "$t_name"
                        json_add_boolean "enabled" "$([ "$t_en" = "1" ] && echo 1 || echo 0)"
                        json_add_string "proto" "$t_proto"
                        json_add_string "proxy_type" "$t_type"
                        json_add_string "local_port" "$t_lport"
                        json_add_string "local_interface" "$t_lif"
                        json_add_string "target_addr" "$t_target_addr"
                        json_add_string "target_port" "$t_target_port"
                        json_add_int "active_connections" "${t_conns:-0}"
                        json_close_object
                    done
                    json_close_array
                    json_add_int "total_tunnels" "$total_t"
                    json_add_int "enabled_tunnels" "$active_t"
                    json_close_object
                    json_dump
                    return
                    ;;
                add|set)
                    if [ -z "$tunnel_name" ]; then
                        msg="隧道名称 (tunnel_name) 不能为空"
                    elif [ -z "$local_port" ]; then
                        msg="本地监听端口 (local_port) 不能为空"
                    else
                        [ -z "$proto" ] && proto="tcp"
                        [ -z "$local_interface" ] && local_interface="any"
                        if [ -z "$proxy_type" ]; then
                            if [ "$proto" = "udp" ]; then
                                proxy_type="forward"
                            elif [ -n "$target_port" ]; then
                                proxy_type="forward"
                            else
                                proxy_type="redir"
                            fi
                        fi

                        uci set xkcptun.${tunnel_name}=client
                        uci set xkcptun.${tunnel_name}.enabled="${enabled:-1}"
                        uci set xkcptun.${tunnel_name}.proto="$proto"
                        uci set xkcptun.${tunnel_name}.proxy_type="$proxy_type"
                        uci set xkcptun.${tunnel_name}.local_port="$local_port"
                        uci set xkcptun.${tunnel_name}.local_interface="$local_interface"
                        [ -n "$target_addr" ] && uci set xkcptun.${tunnel_name}.target_addr="$target_addr"
                        [ -n "$target_port" ] && uci set xkcptun.${tunnel_name}.target_port="$target_port"
                        uci commit xkcptun
                        /etc/init.d/xkcptun restart >/dev/null 2>&1
                        success=1
                        local target_desc="${target_addr:+ 转发至 $target_addr:$target_port}"
                        msg="已成功创建/更新网络加速隧道 [${tunnel_name}] (${proto} 端口 ${local_port}${target_desc})，服务已重启生效"
                    fi
                    ;;
                enable)
                    if [ -z "$tunnel_name" ]; then
                        msg="隧道名称 (tunnel_name) 不能为空"
                    elif [ -z "$(uci -q get xkcptun.${tunnel_name})" ]; then
                        msg="未找到名称为 [${tunnel_name}] 的加速隧道"
                    else
                        uci set xkcptun.${tunnel_name}.enabled="1"
                        uci commit xkcptun
                        /etc/init.d/xkcptun restart >/dev/null 2>&1
                        success=1
                        msg="已成功启用加速隧道 [${tunnel_name}]，服务已重启生效"
                    fi
                    ;;
                disable)
                    if [ -z "$tunnel_name" ]; then
                        msg="隧道名称 (tunnel_name) 不能为空"
                    elif [ -z "$(uci -q get xkcptun.${tunnel_name})" ]; then
                        msg="未找到名称为 [${tunnel_name}] 的加速隧道"
                    else
                        uci set xkcptun.${tunnel_name}.enabled="0"
                        uci commit xkcptun
                        /etc/init.d/xkcptun restart >/dev/null 2>&1
                        success=1
                        msg="已成功停用/禁用加速隧道 [${tunnel_name}]，服务已重启生效"
                    fi
                    ;;
                remove|del|delete)
                    if [ -z "$tunnel_name" ]; then
                        msg="隧道名称 (tunnel_name) 不能为空"
                    elif [ -z "$(uci -q get xkcptun.${tunnel_name})" ]; then
                        msg="未找到名称为 [${tunnel_name}] 的加速隧道"
                    else
                        uci delete xkcptun.${tunnel_name}
                        uci commit xkcptun
                        /etc/init.d/xkcptun restart >/dev/null 2>&1
                        success=1
                        msg="已成功删除加速隧道 [${tunnel_name}]，服务已重启生效"
                    fi
                    ;;
                *)
                    msg="未知的操作动作: $action (支持: list, add, remove, enable, disable)"
                    ;;
            esac

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "action" "$action"
            json_add_string "tunnel_name" "$tunnel_name"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        case "$2" in
            get_status) get_status ;;
            get_wan_mac) get_wan_mac ;;
            get_router_summary) get_router_summary ;;
            list_clients) list_clients ;;
            get_services_status) get_services_status ;;
            run_diagnostics) run_diagnostics ;;
            uci_read) uci_read ;;
            uci_apply) uci_apply ;;
            get_ai_settings) get_ai_settings ;;
            save_ai_settings) save_ai_settings ;;
            call_deepseek) call_deepseek ;;
            get_qos_status) get_qos_status ;;
            set_qos_limit) set_qos_limit ;;
            get_l7_top) get_l7_top ;;
            get_service_detail) get_service_detail ;;
            set_service_detail) set_service_detail ;;
            get_wifi_info) get_wifi_info ;;
            set_wifi_config) set_wifi_config ;;
            get_hw_offload_status) get_hw_offload_status ;;
            set_hw_offload) set_hw_offload ;;
            get_router_ssh_key) get_router_ssh_key ;;
            get_vps_servers) get_vps_servers ;;
            manage_vps_server) manage_vps_server ;;
            test_vps_server) test_vps_server ;;
            test_vps_ssh) test_vps_ssh ;;
            deploy_vps_frps) deploy_vps_frps ;;
            deploy_vps_xkcptun) deploy_vps_xkcptun ;;
            uninstall_vps_service) uninstall_vps_service ;;
            get_penetration_status) get_penetration_status ;;
            manage_xdns_domain) manage_xdns_domain ;;
            manage_portal_access) manage_portal_access ;;
            manage_portal_whitelist) manage_portal_whitelist ;;
            manage_penetration_proxy) manage_penetration_proxy ;;
            manage_xkcptun_tunnel) manage_xkcptun_tunnel ;;
        esac
        ;;
esac
