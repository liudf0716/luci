#!/bin/sh

. /usr/share/libubox/jshn.sh
[ -f /lib/functions.sh ] && . /lib/functions.sh

case "$1" in
    list)
        json_init
        json_add_object "get_status"
        json_close_object
        json_add_object "get_wan_mac"
        json_close_object
        json_add_object "get_router_summary"
        json_close_object
        json_add_object "list_clients"
        json_close_object
        json_add_object "get_services_status"
        json_close_object
        json_add_object "run_diagnostics"
            json_add_string "action"
            json_add_string "target"
        json_close_object
        json_add_object "uci_read"
            json_add_string "package"
        json_close_object
        json_add_object "uci_apply"
            json_add_string "package"
            json_add_string "section"
            json_add_string "option"
            json_add_string "value"
            json_add_string "reload_service"
        json_close_object
        json_add_object "get_ai_settings"
        json_close_object
        json_add_object "save_ai_settings"
            json_add_string "api_key"
            json_add_string "model"
            json_add_string "api_url"
            json_add_string "temperature"
        json_close_object
                                json_add_object "get_qos_status"
        json_close_object
        json_add_object "set_qos_limit"
            json_add_string "target"
            json_add_int "dl_mbps"
            json_add_int "ul_mbps"
            json_add_string "weekdays"
            json_add_string "timestart"
            json_add_string "timestop"
        json_close_object
        json_add_object "get_l7_top"
        json_close_object
        json_add_object "get_service_detail"
            json_add_string "service"
        json_close_object
        json_add_object "set_service_detail"
            json_add_string "service"
            json_add_string "enabled"
            json_add_string "server_addr"
            json_add_string "server_port"
            json_add_string "key"
            json_add_string "token"
            json_add_string "mode"
            json_add_string "gateway"
            json_add_string "disable_portal_auth"
            json_add_string "wired_passed"
            json_add_string "auth_server_mode"
            json_add_string "fec"
            json_add_string "sndwnd"
            json_add_string "rcvwnd"
            json_add_string "datashard"
            json_add_string "parityshard"
            json_add_string "xkcp_dns"
            json_add_string "xkcp_tcp"
            json_add_string "ifname"
        json_close_object
        json_add_object "get_wifi_info"
        json_close_object
        json_add_object "set_wifi_config"
            json_add_string "band"
            json_add_string "ssid"
            json_add_string "key"
            json_add_string "enabled"
        json_close_object
        json_add_object "call_deepseek"
            json_add_string "messages_json"
            json_add_string "tools_json"
        json_close_object
        json_add_object "get_hw_offload_status"
        json_close_object
        json_add_object "set_hw_offload"
            json_add_string "enabled"
            json_add_string "mode"
        json_close_object
        json_add_object "get_router_ssh_key"
        json_close_object
        json_add_object "get_vps_servers"
        json_close_object
        json_add_object "manage_vps_server"
            json_add_string "action"
            json_add_string "id"
            json_add_string "name"
            json_add_string "host"
            json_add_string "port"
            json_add_string "user"
        json_close_object
        json_add_object "test_vps_server"
            json_add_string "id"
            json_add_string "host"
            json_add_string "port"
            json_add_string "user"
        json_close_object
        json_add_object "test_vps_ssh"
            json_add_string "vps_ip"
            json_add_string "vps_port"
            json_add_string "vps_user"
        json_close_object
        json_add_object "deploy_vps_frps"
            json_add_string "vps_ip"
            json_add_string "vps_port"
            json_add_string "vps_user"
            json_add_string "bind_port"
            json_add_string "token"
            json_add_string "remote_web_port"
        json_close_object
        json_add_object "deploy_vps_xkcptun"
            json_add_string "vps_ip"
            json_add_string "vps_port"
            json_add_string "vps_user"
            json_add_string "listen_port"
            json_add_string "key"
            json_add_string "mode"
            json_add_string "fec"
        json_close_object
        json_add_object "uninstall_vps_service"
            json_add_string "id"
            json_add_string "name"
            json_add_string "host"
            json_add_string "port"
            json_add_string "user"
            json_add_string "service"
        json_close_object
        json_add_object "get_penetration_status"
        json_close_object
        json_add_object "manage_xdns_domain"
            json_add_string "action"
            json_add_string "domain"
        json_close_object
        json_add_object "manage_portal_access"
            json_add_string "action"
            json_add_string "mac"
            json_add_string "domain"
            json_add_string "target"
            json_add_string "feature"
            json_add_string "value"
        json_close_object
        json_add_object "manage_portal_whitelist"
            json_add_string "action"
            json_add_string "mac"
        json_close_object
        json_add_object "manage_penetration_proxy"
            json_add_string "action"
            json_add_string "rule_name"
            json_add_string "proxy_type"
            json_add_string "local_ip"
            json_add_string "local_port"
            json_add_string "remote_port"
            json_add_string "subdomain"
            json_add_string "custom_domains"
            json_add_string "use_encryption"
            json_add_string "use_compression"
        json_close_object
        json_add_object "manage_xkcptun_tunnel"
            json_add_string "action"
            json_add_string "tunnel_name"
            json_add_string "proto"
            json_add_string "proxy_type"
            json_add_string "local_port"
            json_add_string "local_interface"
            json_add_string "target_addr"
            json_add_string "target_port"
            json_add_string "enabled"
        json_close_object
        json_dump
        ;;
    call)
        get_status() {
            local running=0
            local pid=""
            if pidof clawwrt >/dev/null 2>&1; then
                running=1
                pid=$(pidof clawwrt)
            fi
            json_init
            json_add_object "result"
            json_add_boolean "running" "$running"
            json_add_string "pid" "$pid"
            json_close_object
            json_dump
        }

        get_wan_mac() {
            local wan_device=$(uci get network.wan.device 2>/dev/null)
            [ -z "$wan_device" ] && wan_device=$(uci get network.wan.ifname 2>/dev/null)
            if [ -z "$wan_device" ]; then
                wan_device=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
                [ -z "$wan_device" ] && wan_device=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.device' 2>/dev/null)
            fi
            [ -z "$wan_device" ] && wan_device=$(ip route | grep default | awk '{print $5}' | head -n1)
            
            if [ -n "$wan_device" ] && [ -e "/sys/class/net/$wan_device" ]; then
                local mac_addr=$(cat "/sys/class/net/$wan_device/address" 2>/dev/null)
                if [ -n "$mac_addr" ] && [ "$mac_addr" != "00:00:00:00:00:00" ]; then
                    json_init
                    json_add_object "result"
                    json_add_string "status" "success"
                    json_add_string "mac" "$mac_addr"
                    json_add_string "interface" "$wan_device"
                    json_close_object
                    json_dump
                    return
                fi
            fi
            
            json_init
            json_add_object "result"
            json_add_string "status" "fail"
            json_add_string "message" "WAN interface not found"
            json_close_object
            json_dump
        }

        get_router_summary() {
            local hostname=$(cat /proc/sys/kernel/hostname 2>/dev/null)
            local uptime_sec=$(cut -d. -f1 /proc/uptime 2>/dev/null)
            local mem_total=$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null)
            local mem_free=$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null)
            local cpu_load=$(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)
            local board_model=$(cat /tmp/sysinfo/model 2>/dev/null || cat /proc/cpuinfo | grep 'model name' | head -n1 | cut -d: -f2 | xargs)
            local kernel_ver=$(uname -r 2>/dev/null)
            local wan_ip=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
            local lan_ip=$(uci get network.lan.ipaddr 2>/dev/null || echo "192.168.8.1")
            
            # Real-time Internet Connectivity Probe
            local online=0
            local latency=""
            local dns_ok=0
            local ping_out=$(ping -c 1 -W 1 223.5.5.5 2>/dev/null)
            if [ $? -eq 0 ]; then
                online=1
                latency=$(echo "$ping_out" | awk -F'/' 'END {print $5}')
            else
                ping_out=$(ping -c 1 -W 1 119.29.29.29 2>/dev/null)
                if [ $? -eq 0 ]; then
                    online=1
                    latency=$(echo "$ping_out" | awk -F'/' 'END {print $5}')
                fi
            fi
            
            if nslookup baidu.com 127.0.0.1 >/dev/null 2>&1 || nslookup baidu.com >/dev/null 2>&1; then
                dns_ok=1
            fi
            
            local client_count=0
            [ -f /tmp/dhcp.leases ] && client_count=$(wc -l < /tmp/dhcp.leases)

            local hw_offload=$(uci -q get firewall.@defaults[0].flow_offloading_hw || echo "0")
            local sw_offload=$(uci -q get firewall.@defaults[0].flow_offloading || echo "0")
            local hw_accel=0
            [ "$sw_offload" = "1" ] && [ "$hw_offload" = "1" ] && hw_accel=1
            
            json_init
            json_add_object "result"
            json_add_string "hostname" "$hostname"
            json_add_int "uptime_seconds" "${uptime_sec:-0}"
            json_add_int "mem_total_kb" "${mem_total:-0}"
            json_add_int "mem_free_kb" "${mem_free:-0}"
            json_add_string "cpu_load" "$cpu_load"
            json_add_string "board_model" "$board_model"
            json_add_string "kernel_version" "$kernel_ver"
            json_add_string "wan_ip" "${wan_ip:-Disconnected}"
            json_add_string "lan_ip" "$lan_ip"
            json_add_boolean "online" "$online"
            json_add_boolean "dns_ok" "$dns_ok"
            json_add_string "latency" "$latency"
            json_add_int "client_count" "${client_count:-0}"
            json_add_boolean "hw_accel" "$hw_accel"
            json_close_object
            json_dump
        }

        list_clients() {
            json_init
            json_add_object "result"
            json_add_array "clients"
            
            if [ -f /tmp/dhcp.leases ]; then
                while read -r ts mac ip name client_id; do
                    [ -z "$ip" ] && continue
                    json_add_object
                    json_add_string "ip" "$ip"
                    json_add_string "mac" "$mac"
                    json_add_string "hostname" "${name:-unknown}"
                    json_add_int "expires_at" "$ts"
                    json_close_object
                done < /tmp/dhcp.leases
            fi
            
            json_close_array
            json_close_object
            json_dump
        }

        get_services_status() {
            local wifidogx_run=0
            local wifidogx_cloud=0
            local xkcptun_run=0
            local xkcptun_conns=0
            local xfrpc_run=0
            local xfrpc_connected=0
            local xdns_run=0
            local xdns_bpf=0
            local xdns_tcp_proxied=0
            local firewall_run=0

            # 1. wifidogx (Captive Portal)
            if pidof wifidogx >/dev/null 2>&1; then
                wifidogx_run=1
                local wd_json=$(/usr/bin/wdctlx status wifidogx 2>/dev/null)
                if [ -n "$wd_json" ]; then
                    local is_ws=$(echo "$wd_json" | jsonfilter -e '@.is_websocket_connected' 2>/dev/null)
                    [ "$is_ws" = "1" ] && wifidogx_cloud=1
                elif /etc/init.d/wifidogx status 2>/dev/null | grep -A 6 "WebSocket Server:" | grep -qi "Connected: yes"; then
                    wifidogx_cloud=1
                fi
            fi

            # 2. xkcptun (Network Acceleration)
            /etc/init.d/xkcptun status 2>/dev/null | grep -E -q "running|active" && xkcptun_run=1
            if [ "$xkcptun_run" -eq 1 ]; then
                local mon_raw=$(wget -qO- -T 1 http://127.0.0.1:9086 2>/dev/null)
                if [ -n "$mon_raw" ]; then
                    xkcptun_conns=$(echo "$mon_raw" | grep "redir_tunnel" | sed -n 's/.*conns: \([0-9]*\).*/\1/p')
                fi
                local redir_port=$(uci -q get xkcptun.redir_tunnel.local_port || echo 12345)
                local est_conns=$(netstat -nt 2>/dev/null | grep ":${redir_port} " | grep -c "ESTABLISHED" || echo 0)
                [ "${est_conns:-0}" -gt "${xkcptun_conns:-0}" ] && xkcptun_conns="$est_conns"
            fi

            # 3. xfrpc (Intranet Penetration)
            /etc/init.d/xfrpc status 2>/dev/null | grep -E -q "running|active" && xfrpc_run=1
            if [ "$xfrpc_run" -eq 1 ]; then
                netstat -ntp 2>/dev/null | grep "[0-9]*/xfrpc" | grep -q "ESTABLISHED" && xfrpc_connected=1
            fi

            # 4. xdns (Smart Traffic Diversion & eBPF DNS interception)
            if tc filter show dev br-lan ingress 2>/dev/null | grep -q "xdns_bpf"; then
                xdns_bpf=1
                xdns_run=1
            elif /etc/init.d/xdns status 2>/dev/null | grep -E -q "running|active"; then
                xdns_run=1
            fi
            if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                xdns_tcp_proxied=$(/usr/bin/xdns-ctl stats 2>/dev/null | grep "TCP Connections Proxied" | awk '{print $NF}')
            fi

            # 5. firewall (Linux nftables fw4)
            if /etc/init.d/firewall status 2>/dev/null | grep -E -q "running|active" || \
               nft list table inet fw4 >/dev/null 2>&1; then
                firewall_run=1
            fi

            json_init
            json_add_object "result"
            json_add_boolean "wifidogx" "$wifidogx_run"
            json_add_boolean "wifidogx_cloud_connected" "$wifidogx_cloud"
            json_add_boolean "xkcptun" "$xkcptun_run"
            json_add_int "xkcptun_active_connections" "${xkcptun_conns:-0}"
            json_add_boolean "xfrpc" "$xfrpc_run"
            json_add_boolean "xfrpc_connected" "$xfrpc_connected"
            json_add_boolean "xdns" "$xdns_run"
            json_add_boolean "xdns_bpf_attached" "$xdns_bpf"
            json_add_int "xdns_proxied_connections" "${xdns_tcp_proxied:-0}"
            json_add_boolean "firewall" "$firewall_run"
            json_close_object
            json_dump
        }

        run_diagnostics() {
            read -r input
            json_load "$input"
            json_get_var action "action"
            json_get_var target "target"
            
            local out=""
            case "$action" in
                ping)
                    [ -z "$target" ] && target="223.5.5.5"
                    out=$(ping -c 3 -W 2 "$target" 2>&1)
                    ;;
                nslookup)
                    [ -z "$target" ] && target="github.com"
                    out=$(nslookup "$target" 2>&1)
                    ;;
                route)
                    out=$(ip route 2>&1)
                    ;;
                *)
                    out="Unknown action: $action"
                    ;;
            esac
            
            json_init
            json_add_object "result"
            json_add_string "action" "$action"
            json_add_string "target" "$target"
            json_add_string "output" "$out"
            json_close_object
            json_dump
        }

        uci_read() {
            read -r input
            json_load "$input"
            json_get_var package "package"
            
            local out=""
            if [ -n "$package" ]; then
                out=$(uci -q show "$package" 2>&1)
            fi
            
            json_init
            json_add_object "result"
            json_add_string "package" "$package"
            json_add_string "config" "$out"
            json_close_object
            json_dump
        }

        uci_apply() {
            read -r input
            json_load "$input"
            json_get_var package "package"
            json_get_var section "section"
            json_get_var option "option"
            json_get_var value "value"
            json_get_var reload_service "reload_service"
            
            local success=0
            local msg="OK"
            
            if [ -n "$package" ] && [ -n "$section" ] && [ -n "$option" ]; then
                uci set "${package}.${section}.${option}=${value}" 2>/dev/null && \
                uci commit "${package}" 2>/dev/null && success=1
                
                if [ $success -eq 1 ] && [ -n "$reload_service" ]; then
                    if [ -x "/etc/init.d/$reload_service" ]; then
                        /etc/init.d/"$reload_service" reload >/dev/null 2>&1 || \
                        /etc/init.d/"$reload_service" restart >/dev/null 2>&1
                    fi
                fi
            else
                msg="Missing parameters: package, section, option required"
            fi
            
            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        get_ai_settings() {
            local key=$(uci -q get clawwrt.ai.api_key)
            local model=$(uci -q get clawwrt.ai.model || echo "deepseek-flash")
            local api_url=$(uci -q get clawwrt.ai.api_url || echo "https://api.deepseek.com/chat/completions")
            local temp=$(uci -q get clawwrt.ai.temperature || echo "0.3")
            
            local masked_key=""
            if [ -n "$key" ]; then
                local len=${#key}
                if [ $len -gt 8 ]; then
                    masked_key="$(echo "$key" | cut -c1-4)...$(echo "$key" | cut -c$((len-3))-$len)"
                else
                    masked_key="********"
                fi
            fi
            
            json_init
            json_add_object "result"
            json_add_string "model" "$model"
            json_add_string "api_url" "$api_url"
            json_add_string "temperature" "$temp"
            json_add_string "api_key_masked" "$masked_key"
            json_add_boolean "has_key" "$([ -n "$key" ] && echo 1 || echo 0)"
            json_close_object
            json_dump
        }

        save_ai_settings() {
            read -r input
            json_load "$input"
            json_get_var api_key "api_key"
            json_get_var model "model"
            json_get_var api_url "api_url"
            json_get_var temperature "temperature"
            
            local old_key=$(uci -q get clawwrt.ai.api_key)
            [ -z "$api_key" ] && api_key="$old_key"
            
            uci -q delete clawwrt.ai
            uci -q set clawwrt.ai=ai
            [ -n "$api_key" ] && uci -q set clawwrt.ai.api_key="$api_key"
            [ -n "$model" ] && uci -q set clawwrt.ai.model="$model" || uci -q set clawwrt.ai.model="deepseek-flash"
            [ -n "$api_url" ] && uci -q set clawwrt.ai.api_url="$api_url" || uci -q set clawwrt.ai.api_url="https://api.deepseek.com/chat/completions"
            [ -n "$temperature" ] && uci -q set clawwrt.ai.temperature="$temperature" || uci -q set clawwrt.ai.temperature="0.3"
            uci -q commit clawwrt
            
            json_init
            json_add_object "result"
            json_add_boolean "success" "1"
            json_close_object
            json_dump
        }

        call_deepseek() {
            read -r input
            json_load "$input"
            json_get_var messages_json "messages_json"
            json_get_var tools_json "tools_json"
            
            local key=$(uci -q get clawwrt.ai.api_key)
            local model=$(uci -q get clawwrt.ai.model || echo "deepseek-flash")
            local api_url=$(uci -q get clawwrt.ai.api_url || echo "https://api.deepseek.com/chat/completions")
            local temp=$(uci -q get clawwrt.ai.temperature || echo "0.3")
            
            if [ -z "$key" ]; then
                json_init
                json_add_object "result"
                json_add_boolean "error" "1"
                json_add_string "message" "DeepSeek API key is not configured in settings."
                json_close_object
                json_dump
                return
            fi
            
            local req_body="/tmp/deepseek_req_$$.json"
            local resp_body="/tmp/deepseek_resp_$$.json"
            
            if [ -n "$tools_json" ] && [ "$tools_json" != "null" ]; then
                printf '{"model":"%s","messages":%s,"tools":%s,"temperature":%s,"stream":false}' \
                    "$model" "$messages_json" "$tools_json" "$temp" > "$req_body"
            else
                printf '{"model":"%s","messages":%s,"temperature":%s,"stream":false}' \
                    "$model" "$messages_json" "$temp" > "$req_body"
            fi
            
            local http_code=$(curl -s -m 60 -o "$resp_body" -w "%{http_code}" -X POST "$api_url" \
                -H "Content-Type: application/json" \
                -H "Authorization: Bearer $key" \
                --data-binary @"$req_body" 2>/dev/null)
                
            local resp_content=$(cat "$resp_body" 2>/dev/null)
            rm -f "$req_body" "$resp_body"
            
            json_init
            json_add_object "result"
            json_add_int "http_code" "${http_code:-0}"
            json_add_string "response" "$resp_content"
            json_close_object
            json_dump
        }

        
        get_wifi_info() {
            json_init
            json_add_object "result"
            json_add_array "radios"
            
            for rad in radio0 radio1; do
                local band=$(uci -q get wireless.${rad}.band)
                local channel=$(uci -q get wireless.${rad}.channel)
                [ -z "$band" ] && continue
                
                for iface in $(uci -q show wireless | grep '=wifi-iface' | cut -d. -f2 | cut -d= -f1); do
                    local dev=$(uci -q get wireless.${iface}.device)
                    local mode=$(uci -q get wireless.${iface}.mode)
                    if [ "$dev" = "$rad" ] && [ "$mode" = "ap" ]; then
                        local ssid=$(uci -q get wireless.${iface}.ssid)
                        local key=$(uci -q get wireless.${iface}.key)
                        local enc=$(uci -q get wireless.${iface}.encryption || echo 'psk2')
                        local dis=$(uci -q get wireless.${iface}.disabled || echo '0')
                        
                        json_add_object
                        json_add_string "radio" "$rad"
                        json_add_string "section" "$iface"
                        json_add_string "band" "$band"
                        json_add_string "ssid" "$ssid"
                        json_add_string "key" "$key"
                        json_add_string "encryption" "$enc"
                        json_add_string "channel" "$channel"
                        json_add_boolean "enabled" "$([ "$dis" = "0" ] && echo 1 || echo 0)"
                        json_close_object
                    fi
                done
            done
            
            json_close_array
            json_close_object
            json_dump
        }

        set_wifi_config() {
            read -r input
            json_load "$input"
            json_get_var band "band"
            json_get_var ssid "ssid"
            json_get_var key "key"
            json_get_var enabled "enabled"
            
            [ -z "$band" ] && band="all"
            
            if [ -n "$key" ]; then
                local klen=${#key}
                if [ "$klen" -lt 8 ]; then
                    json_init
                    json_add_object "result"
                    json_add_boolean "success" "0"
                    json_add_string "message" "WiFi 密码长度不能少于 8 位！"
                    json_close_object
                    json_dump
                    return
                fi
            fi
            
            local modified=0
            for rad in radio0 radio1; do
                local rband=$(uci -q get wireless.${rad}.band)
                local match=0
                if [ "$band" = "all" ]; then
                    match=1
                elif [ "$band" = "$rband" ] || [ "$band" = "${rband}g" ] || [ "$band" = "${rband%g}G" ] || [ "$band" = "2.4G" -a "$rband" = "2g" ] || [ "$band" = "5G" -a "$rband" = "5g" ]; then
                    match=1
                fi
                
                if [ $match -eq 1 ]; then
                    for iface in $(uci -q show wireless | grep '=wifi-iface' | cut -d. -f2 | cut -d= -f1); do
                        local dev=$(uci -q get wireless.${iface}.device)
                        local mode=$(uci -q get wireless.${iface}.mode)
                        if [ "$dev" = "$rad" ] && [ "$mode" = "ap" ]; then
                            [ -n "$ssid" ] && uci set wireless.${iface}.ssid="$ssid"
                            [ -n "$key" ] && uci set wireless.${iface}.key="$key"
                            if [ -n "$enabled" ]; then
                                if [ "$enabled" = "1" ] || [ "$enabled" = "true" ]; then
                                    uci set wireless.${iface}.disabled='0'
                                else
                                    uci set wireless.${iface}.disabled='1'
                                fi
                            fi
                            modified=$((modified + 1))
                        fi
                    done
                fi
            done
            
            if [ "$modified" -gt 0 ]; then
                uci commit wireless
                /sbin/wifi reload >/dev/null 2>&1
                json_init
                json_add_object "result"
                json_add_boolean "success" "1"
                json_add_int "modified_count" "$modified"
                json_add_string "message" "WiFi 配置已成功应用并生效！"
                json_close_object
                json_dump
            else
                json_init
                json_add_object "result"
                json_add_boolean "success" "0"
                json_add_string "message" "未找到匹配的无线 AP 接口"
                json_close_object
                json_dump
            fi
        }

        
        get_service_detail() {
            read -r input
            json_load "$input"
            json_get_var service "service"
            
            json_init
            json_add_object "result"
            json_add_string "service" "$service"
            
            case "$service" in
                wifidogx)
                    local run=0
                    if pidof wifidogx >/dev/null 2>&1; then
                        run=1
                    fi
                    local wd_status=$(/usr/bin/wdctlx status wifidogx 2>/dev/null)
                    local auth_status=$(/usr/bin/wdctlx status auth 2>/dev/null)
                    local user_list_json=$(/usr/bin/wdctlx apfree user_list 2>/dev/null)

                    local version=$(echo "$wd_status" | jsonfilter -e '@.wifidogx_version' 2>/dev/null)
                    [ -z "$version" ] && version=$(echo "$user_list_json" | jsonfilter -e '@["apfree version"]' 2>/dev/null)
                    local uptime_sec=$(echo "$wd_status" | jsonfilter -e '@.uptime' 2>/dev/null)
                    local is_ws=$(echo "$wd_status" | jsonfilter -e '@.is_websocket_connected' 2>/dev/null)
                    local is_auth=$(echo "$wd_status" | jsonfilter -e '@.is_auth_server_connected' 2>/dev/null)
                    local is_net=$(echo "$wd_status" | jsonfilter -e '@.is_internet_connected' 2>/dev/null)
                    local ws_host=$(echo "$auth_status" | jsonfilter -e '@.auth_servers[0].host' 2>/dev/null)
                    [ -z "$ws_host" ] && ws_host=$(uci -q get wifidogx.kswifi_conn.ws_server_hostname || echo "kswifi.com")

                    local ws_connected=0
                    [ "$is_ws" = "1" ] && ws_connected=1

                    json_add_boolean "running" "$run"
                    json_add_string "enabled" "$(uci -q get wifidogx.common.enabled || echo 0)"
                    json_add_string "auth_server_mode" "$(uci -q get wifidogx.common.auth_server_mode || echo cloud)"
                    json_add_string "disable_portal_auth" "$(uci -q get wifidogx.common.disable_portal_auth || echo 0)"
                    json_add_string "wired_passed" "$(uci -q get wifidogx.common.wired_passed || echo 0)"
                    json_add_string "enable_anti_nat" "$(uci -q get wifidogx.common.enable_anti_nat || echo 0)"
                    json_add_string "version" "${version:-9.10}"
                    json_add_string "uptime" "${uptime_sec:-0}s"
                    json_add_boolean "internet_connected" "$([ "$is_net" = "1" ] && echo 1 || echo 0)"
                    json_add_boolean "auth_server_connected" "$([ "$is_auth" = "1" ] && echo 1 || echo 0)"
                    json_add_boolean "websocket_connected" "$ws_connected"
                    json_add_string "auth_server_host" "${ws_host:-kswifi.com}"

                    # 1. 信任免认证 MAC 白名单
                    json_add_array "trusted_macs"
                    for mac in $(uci -q get wifidogx.common.trusted_macs); do
                        json_add_string "" "$mac"
                    done
                    json_close_array

                    # 2. 拦截黑名单 MAC
                    json_add_array "untrusted_macs"
                    for mac in $(uci -q get wifidogx.common.untrust_macs); do
                        json_add_string "" "$mac"
                    done
                    json_close_array

                    # 3. 免认证放行域名
                    json_add_array "trusted_domains"
                    for d in $(uci -q get wifidogx.common.trusted_domains); do
                        json_add_string "" "$d"
                    done
                    json_close_array

                    # 4. 免认证放行通配符域名
                    json_add_array "trusted_wildcard_domains"
                    for wd in $(uci -q get wifidogx.common.trusted_wildcard_domains); do
                        json_add_string "" "$wd"
                    done
                    json_close_array

                    # 5. 实时在线认证用户列表 (从 apfree user_list 解析)
                    json_add_array "online_users"
                    local online_count=0
                    if [ -n "$user_list_json" ]; then
                        local users_raw=$(echo "$user_list_json" | jsonfilter -e '@["online user"][*]' 2>/dev/null)
                        while read -r uline; do
                            [ -z "$uline" ] && continue
                            local umac=$(echo "$uline" | jsonfilter -e '@.mac' 2>/dev/null)
                            local rem=$(echo "$uline" | jsonfilter -e '@["remaining time"]' 2>/dev/null)
                            [ -z "$umac" ] && continue
                            online_count=$((online_count + 1))
                            [ -z "$rem" ] && rem=0

                            local uip=""
                            local uhost=""
                            if [ -f /tmp/dhcp.leases ]; then
                                local lease_line=$(grep -i "$umac" /tmp/dhcp.leases | head -n1)
                                uip=$(echo "$lease_line" | awk '{print $3}')
                                uhost=$(echo "$lease_line" | awk '{print $4}')
                                [ "$uhost" = "*" ] && uhost=""
                            fi

                            local rem_str=""
                            if [ "$rem" -ge 3600 ]; then
                                rem_str="$((rem / 3600))小时$(( (rem % 3600) / 60 ))分"
                            elif [ "$rem" -ge 60 ]; then
                                rem_str="$((rem / 60))分钟"
                            else
                                rem_str="${rem}秒"
                            fi

                            json_add_object ""
                            json_add_string "mac" "$umac"
                            json_add_string "ip" "${uip:-未知}"
                            json_add_string "hostname" "${uhost:-未知设备}"
                            json_add_int "remaining_seconds" "$rem"
                            json_add_string "remaining_time" "$rem_str"
                            json_close_object
                        done <<EOF
$users_raw
EOF
                    fi
                    json_close_array
                    json_add_int "active_clients" "$online_count"

                    local diag="wifidogx 门户认证已关闭"
                    if [ "$run" -eq 1 ]; then
                        local auth_mode_desc="云端认证模式"
                        local cur_mode=$(uci -q get wifidogx.common.auth_server_mode || echo cloud)
                        [ "$cur_mode" = "local" ] && auth_mode_desc="本地认证模式"
                        [ "$cur_mode" = "bypass" ] && auth_mode_desc="旁路放行模式"

                        if [ "$(uci -q get wifidogx.common.disable_portal_auth)" = "1" ]; then
                            diag="wifidogx 门户服务运行中，但当前处于【免认证直通模式】（所有设备无需网页登录即可自由上网）。"
                        elif [ "$ws_connected" -eq 1 ]; then
                            diag="wifidogx 门户认证运行正常 ($auth_mode_desc)，已连通云端 WebSocket (${ws_host})，当前有 $online_count 位在线认证用户，放行白名单终端 $(uci -q get wifidogx.common.trusted_macs | wc -w) 台，黑名单拦截 $(uci -q get wifidogx.common.untrust_macs | wc -w) 台。"
                        else
                            diag="wifidogx 进程运行中，但云端 WebSocket 尚未连通 (${ws_host})，请检查外网连接或认证服务地址。"
                        fi
                    fi
                    json_add_string "diagnosis" "$diag"
                    ;;
                xfrpc)
                    local run=0
                    /etc/init.d/xfrpc status 2>/dev/null | grep -E -q 'running|active' && run=1
                    local sock_state=$(netstat -ntp 2>/dev/null | grep "[0-9]*/xfrpc" | head -n1 | awk '{print $6}')
                    local conn=0
                    [ "$sock_state" = "ESTABLISHED" ] && conn=1
                    json_add_boolean "running" "$run"
                    json_add_boolean "connected_to_frps" "$conn"
                    json_add_string "socket_state" "${sock_state:-NONE}"
                    json_add_string "enabled" "$(uci -q get xfrpc.common.enabled || echo 0)"
                    json_add_string "server_addr" "$(uci -q get xfrpc.common.server_addr)"
                    json_add_string "server_port" "$(uci -q get xfrpc.common.server_port)"
                    json_add_string "protocol" "$(uci -q get xfrpc.common.protocol || echo tcp)"
                    json_add_string "token" "$(uci -q get xfrpc.common.token)"

                    local diag="xfrpc 内网穿透已停用"
                    if [ "$run" -eq 1 ]; then
                        if [ "$conn" -eq 1 ]; then
                            diag="xfrpc 客户端运行正常，且已成功连接远端 frps 服务端 (ESTABLISHED)。"
                        elif [ "$sock_state" = "SYN_SENT" ]; then
                            diag="xfrpc 客户端正在运行，但与远端 frps 服务端处于握手超时状态 (SYN_SENT)，请检查 VPS 防火墙或端口。"
                        else
                            diag="xfrpc 客户端正在运行，但尚未连接远端 frps (套接字: ${sock_state:-NONE})。"
                        fi
                    fi
                    json_add_string "diagnosis" "$diag"

                    local p_total=0
                    local p_active=0
                    json_add_array "proxies"
                    for sec in $(uci -q show xfrpc | grep -E "=(tcp|http|https|udp|socks5|stcp|xtcp|sudp|tcpmux)" | cut -d. -f2 | cut -d= -f1); do
                        local type=$(uci -q get xfrpc.${sec})
                        local penabled=$(uci -q get xfrpc.${sec}.enabled || echo 1)
                        local lip=$(uci -q get xfrpc.${sec}.local_ip)
                        local lport=$(uci -q get xfrpc.${sec}.local_port)
                        local rport=$(uci -q get xfrpc.${sec}.remote_port)
                        local subdomain=$(uci -q get xfrpc.${sec}.subdomain)
                        local custom_domains=$(uci -q get xfrpc.${sec}.custom_domains)
                        local is_p_en=0
                        [ "$penabled" = "1" ] && is_p_en=1
                        p_total=$((p_total + 1))
                        [ "$is_p_en" -eq 1 ] && p_active=$((p_active + 1))

                        json_add_object
                        json_add_string "name" "$sec"
                        json_add_string "type" "$type"
                        json_add_boolean "enabled" "$is_p_en"
                        json_add_string "local_target" "${lip:+${lip}:}${lport}"
                        json_add_string "remote_port" "$rport"
                        json_add_string "subdomain" "$subdomain"
                        json_add_string "custom_domains" "$custom_domains"
                        json_close_object
                    done
                    json_close_array
                    json_add_int "proxies_total" "$p_total"
                    json_add_int "proxies_enabled" "$p_active"
                    ;;
                xkcptun)
                    local run=0
                    /etc/init.d/xkcptun status 2>/dev/null | grep -E -q 'running|active' && run=1
                    local remote_addr=$(uci -q get xkcptun.client.remote_addr)
                    local remote_port=$(uci -q get xkcptun.client.remote_port)
                    local mode=$(uci -q get xkcptun.client.mode || echo fast3)
                    local key=$(uci -q get xkcptun.client.key)
                    local enabled=$(uci -q get xkcptun.client.enabled || echo 0)
                    local fec=$(uci -q get xkcptun.client.fec || echo 1)
                    local sndwnd=$(uci -q get xkcptun.client.sndwnd || echo 4096)
                    local rcvwnd=$(uci -q get xkcptun.client.rcvwnd || echo 4096)
                    local datashard=$(uci -q get xkcptun.client.datashard || echo 10)
                    local parityshard=$(uci -q get xkcptun.client.parityshard || echo 3)
                    local nodelay=$(uci -q get xkcptun.client.nodelay || echo 1)
                    local nc=$(uci -q get xkcptun.client.nc || echo 1)

                    local ping_ms=""
                    if [ -n "$remote_addr" ]; then
                        ping_ms=$(ping -c 1 -W 1 "$remote_addr" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\) ms/\1/p')
                    fi

                    local mon_raw=$(wget -qO- -T 1 http://127.0.0.1:9086 2>/dev/null)
                    local active=0
                    [ -n "$mon_raw" ] && active=1

                    json_add_boolean "running" "$run"
                    json_add_boolean "active" "$active"
                    json_add_string "enabled" "$enabled"
                    json_add_string "remote_addr" "$remote_addr"
                    json_add_string "remote_port" "$remote_port"
                    json_add_string "mode" "$mode"
                    json_add_string "key" "$key"
                    json_add_string "ping_ms" "$ping_ms"
                    json_add_string "fec" "$fec"
                    json_add_string "sndwnd" "$sndwnd"
                    json_add_string "rcvwnd" "$rcvwnd"
                    json_add_string "datashard" "$datashard"
                    json_add_string "parityshard" "$parityshard"
                    json_add_string "nodelay" "$nodelay"
                    json_add_string "nc" "$nc"

                    json_add_array "tunnels"
                    local total_conns=0
                    for sec in $(uci -q show xkcptun | grep '=client$' | cut -d. -f2 | cut -d= -f1); do
                        local t_name="$sec"
                        local t_en=$(uci -q get xkcptun.${sec}.enabled || echo 1)
                        local t_proto=$(uci -q get xkcptun.${sec}.proto || echo tcp)
                        local t_type=$(uci -q get xkcptun.${sec}.proxy_type)
                        [ -z "$t_type" ] && { [ "$t_proto" = "udp" ] && t_type="forward" || t_type="redir"; }
                        local t_lport=$(uci -q get xkcptun.${sec}.local_port)
                        local t_lif=$(uci -q get xkcptun.${sec}.local_interface || echo any)
                        local t_target_addr=$(uci -q get xkcptun.${sec}.target_addr)
                        local t_target_port=$(uci -q get xkcptun.${sec}.target_port)
                        local t_conns=0
                        if [ -n "$mon_raw" ]; then
                            t_conns=$(echo "$mon_raw" | grep "\[${t_name}\]" | sed -n 's/.*conns: \([0-9]*\).*/\1/p' | head -n1)
                            [ -z "$t_conns" ] && t_conns=0
                        fi
                        if [ "$t_type" = "redir" ] && [ -n "$t_lport" ]; then
                            local est=$(netstat -nt 2>/dev/null | grep ":${t_lport} " | grep -c "ESTABLISHED" || echo 0)
                            [ "${est:-0}" -gt "${t_conns:-0}" ] && t_conns="$est"
                        fi
                        total_conns=$((total_conns + t_conns))
                        json_add_object ""
                        json_add_string "name" "$t_name"
                        json_add_boolean "enabled" "$([ "$t_en" = "1" ] && echo 1 || echo 0)"
                        json_add_string "proto" "$t_proto"
                        json_add_string "proxy_type" "$t_type"
                        json_add_string "local_port" "$t_lport"
                        json_add_string "local_interface" "$t_lif"
                        json_add_string "target_addr" "$t_target_addr"
                        json_add_string "target_port" "$t_target_port"
                        json_add_int "active_connections" "${t_conns:-0}"
                        json_close_object
                    done
                    json_close_array

                    json_add_int "active_connections" "${total_conns:-0}"

                    json_add_array "sample_connections"
                    if [ "$active" -eq 1 ]; then
                        local status_raw=$(echo "status" | nc 127.0.0.1 9086 2>/dev/null)
                        if [ -n "$status_raw" ]; then
                            local s_lines=$(echo "$status_raw" | grep "conv \[" | head -n 8)
                            while read -r sline; do
                                [ -z "$sline" ] && continue
                                local conv_id=$(echo "$sline" | sed -n 's/.*conv \[\([0-9]*\)\].*/\1/p')
                                local dest=$(echo "$sline" | sed -n 's/.*-> \[\([^]]*\)\]:\[\([^]]*\)\].*/\1:\2/p')
                                [ -n "$dest" ] && {
                                    json_add_object ""
                                    json_add_string "conv" "$conv_id"
                                    json_add_string "target" "$dest"
                                    json_close_object
                                }
                            done <<EOF
$s_lines
EOF
                        fi
                    fi
                    json_close_array

                    local diag="xkcptun 网络加速已停用"
                    if [ "$run" -eq 1 ]; then
                        if [ "$active" -eq 1 ]; then
                            local rtt_desc=""
                            [ -n "$ping_ms" ] && rtt_desc=", 节点往返延迟: ${ping_ms}ms"
                            local fec_desc="未开启"
                            [ "$fec" = "1" ] && fec_desc="开启 (${datashard}+${parityshard})"
                            diag="xkcptun 网络加速运行正常，KCP 传输引擎已建立，正在对加速节点 ($remote_addr:$remote_port, 模式: $mode, FEC抗丢包: $fec_desc$rtt_desc) 进行双向加速，当前总活跃加速连接数: ${total_conns:-0}。"
                        else
                            diag="xkcptun 客户端进程运行中，但监控端口尚未就绪，可能正在建立连接至节点 $remote_addr:$remote_port。"
                        fi
                    fi
                    json_add_string "diagnosis" "$diag"
                    ;;
                xdns)
                    local run=0
                    local bpf_attached=0
                    if tc filter show dev br-lan ingress 2>/dev/null | grep -q 'xdns_bpf'; then
                        bpf_attached=1
                        run=1
                    elif /etc/init.d/xdns status 2>/dev/null | grep -E -q 'running|active'; then
                        run=1
                    fi

                    local ctl_stats=$(/usr/bin/xdns-ctl stats 2>/dev/null)
                    local dns_intercepted=0
                    local dns_proxied=0
                    local dns_learned=0
                    local tcp_proxied=0
                    if [ -n "$ctl_stats" ]; then
                        dns_intercepted=$(echo "$ctl_stats" | grep "DNS Queries Intercepted" | awk '{print $NF}')
                        dns_proxied=$(echo "$ctl_stats" | grep "DNS Queries Proxied" | awk '{print $NF}')
                        dns_learned=$(echo "$ctl_stats" | grep "DNS Responses Learned" | awk '{print $NF}')
                        tcp_proxied=$(echo "$ctl_stats" | grep "TCP Connections Proxied" | awk '{print $NF}')
                    fi

                    local domains_file=$(uci -q get xdns.global.proxy_domains_file || echo "/etc/xdns/proxy_domains.txt")
                    local total_domains=0
                    if [ -f "$domains_file" ]; then
                        total_domains=$(grep -v '^[[:space:]]*#' "$domains_file" | grep -v '^[[:space:]]*$' | wc -l)
                    fi

                    local total_sessions=0
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        total_sessions=$(/usr/bin/xdns-ctl list-sessions 2>/dev/null | grep -E '^[0-9]' | wc -l)
                    fi

                    local total_ips=0
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        total_ips=$(/usr/bin/xdns-ctl list-ips 2>/dev/null | grep -E '^[0-9]' | wc -l)
                    fi

                    json_add_boolean "running" "$run"
                    json_add_boolean "bpf_attached" "$bpf_attached"
                    json_add_string "enabled" "$(uci -q get xdns.global.enabled || echo 0)"
                    json_add_string "ifname" "$(uci -q get xdns.global.ifname || echo br-lan)"
                    json_add_string "xkcp_dns" "$(uci -q get xdns.global.xkcp_dns)"
                    json_add_string "xkcp_tcp" "$(uci -q get xdns.global.xkcp_tcp)"
                    json_add_int "dns_queries_intercepted" "${dns_intercepted:-0}"
                    json_add_int "dns_queries_proxied" "${dns_proxied:-0}"
                    json_add_int "dns_responses_learned" "${dns_learned:-0}"
                    json_add_int "tcp_connections_proxied" "${tcp_proxied:-0}"
                    json_add_int "total_proxy_domains" "${total_domains:-0}"
                    json_add_int "total_hijacked_ips" "${total_ips:-0}"
                    json_add_int "active_sessions" "${total_sessions:-0}"

                    json_add_array "domains"
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local ctl_domains=$(/usr/bin/xdns-ctl list-domains 2>/dev/null | grep -E '\s+Active\s*$' || true)
                        while read -r dline; do
                            [ -z "$dline" ] && continue
                            local dname=$(echo "$dline" | awk '{print $1}')
                            local dhash=$(echo "$dline" | awk '{print $2}')
                            local dstate=$(echo "$dline" | awk '{print $3}')
                            [ -z "$dname" ] || [ "$dname" = "Domain" ] && continue
                            json_add_object ""
                            json_add_string "domain" "$dname"
                            json_add_string "hash" "$dhash"
                            json_add_string "state" "$dstate"
                            json_close_object
                        done <<EOF
$ctl_domains
EOF
                    elif [ -f "$domains_file" ]; then
                        for d in $(grep -v '^[[:space:]]*#' "$domains_file" | grep -v '^[[:space:]]*$'); do
                            json_add_object ""
                            json_add_string "domain" "$d"
                            json_add_string "state" "Configured"
                            json_close_object
                        done
                    fi
                    json_close_array

                    json_add_array "sample_ips"
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local ctl_ips=$(/usr/bin/xdns-ctl list-ips 2>/dev/null | grep -E '^[0-9]' | head -n 10)
                        while read -r ipline; do
                            [ -z "$ipline" ] && continue
                            local ip_addr=$(echo "$ipline" | awk '{print $1}')
                            local exp_time=$(echo "$ipline" | awk '{print $2}')
                            json_add_object ""
                            json_add_string "ip" "$ip_addr"
                            json_add_string "expires_in" "$exp_time"
                            json_close_object
                        done <<EOF
$ctl_ips
EOF
                    fi
                    json_close_array

                    json_add_array "sample_sessions"
                    if command -v /usr/bin/xdns-ctl >/dev/null 2>&1; then
                        local ctl_sessions=$(/usr/bin/xdns-ctl list-sessions 2>/dev/null | grep -E '^[0-9]' | head -n 8)
                        while read -r sline; do
                            [ -z "$sline" ] && continue
                            local client_ep=$(echo "$sline" | awk '{print $1}')
                            local target_ep=$(echo "$sline" | awk '{print $2}')
                            local last_seen=$(echo "$sline" | awk '{$1=""; $2=""; print $0}' | sed 's/^[[:space:]]*//')
                            json_add_object ""
                            json_add_string "client" "$client_ep"
                            json_add_string "target" "$target_ep"
                            json_add_string "last_seen" "$last_seen"
                            json_close_object
                        done <<EOF
$ctl_sessions
EOF
                    fi
                    json_close_array

                    local diag="xdns 智能分流已关闭"
                    if [ "$run" -eq 1 ]; then
                        if [ "$bpf_attached" -eq 1 ]; then
                            diag="xdns-bpf 智能分流在内核 TC ingress/egress 挂载正常！已管理 $total_domains 个加速域名，当前内核维护 $total_ips 个动态劫持加速 IP，累计拦截 DNS 解析 $dns_intercepted 次，动态分流 TCP 加速连接 $tcp_proxied 次，当前活跃加速会话 $total_sessions 个。"
                        else
                            diag="xdns 服务正在运行，但内核 TC eBPF 探针未挂载，请检查 br-lan 网络接口。"
                        fi
                    fi
                    json_add_string "diagnosis" "$diag"
                    ;;
                ipsec)
                    local run=0
                    /etc/init.d/swanctl status 2>/dev/null | grep -E -q 'running|active' && run=1
                    json_add_boolean "running" "$run"
                    local remote_sec=$(uci -q show ipsec | grep '=remote' | cut -d. -f2 | cut -d= -f1 | head -n1)
                    [ -z "$remote_sec" ] && remote_sec="dhcs"
                    json_add_string "enabled" "$(uci -q get ipsec.${remote_sec}.enabled || echo 0)"
                    json_add_string "gateway" "$(uci -q get ipsec.${remote_sec}.gateway)"
                    json_add_string "keyexchange" "$(uci -q get ipsec.${remote_sec}.keyexchange || echo ikev2)"
                    ;;
                *)
                    json_add_string "error" "Unknown service: $service"
                    ;;
            esac
            
            json_close_object
            json_dump
        }

        set_service_detail() {
            read -r input
            json_load "$input"
            json_get_var service "service"
            json_get_var enabled "enabled"
            json_get_var server_addr "server_addr"
            json_get_var server_port "server_port"
            json_get_var key "key"
            json_get_var token "token"
            json_get_var mode "mode"
            json_get_var gateway "gateway"
            json_get_var disable_portal_auth "disable_portal_auth"
            json_get_var wired_passed "wired_passed"
            json_get_var auth_server_mode "auth_server_mode"
            json_get_var enable_anti_nat "enable_anti_nat"
            json_get_var fec "fec"
            json_get_var sndwnd "sndwnd"
            json_get_var rcvwnd "rcvwnd"
            json_get_var datashard "datashard"
            json_get_var parityshard "parityshard"
            json_get_var xkcp_dns "xkcp_dns"
            json_get_var xkcp_tcp "xkcp_tcp"
            json_get_var ifname "ifname"
            
            local success=1
            local msg="配置已成功应用并重启服务生效"
            
            case "$service" in
                wifidogx)
                    [ -n "$enabled" ] && uci set wifidogx.common.enabled="$enabled"
                    [ -n "$disable_portal_auth" ] && uci set wifidogx.common.disable_portal_auth="$disable_portal_auth"
                    [ -n "$wired_passed" ] && uci set wifidogx.common.wired_passed="$wired_passed"
                    [ -n "$auth_server_mode" ] && uci set wifidogx.common.auth_server_mode="$auth_server_mode"
                    [ -n "$enable_anti_nat" ] && uci set wifidogx.common.enable_anti_nat="$enable_anti_nat"
                    uci commit wifidogx
                    if [ "$enabled" = "0" ]; then
                        /etc/init.d/wifidogx stop >/dev/null 2>&1
                    else
                        /etc/init.d/wifidogx restart >/dev/null 2>&1
                    fi
                    ;;
                xfrpc)
                    [ -n "$enabled" ] && uci set xfrpc.common.enabled="$enabled"
                    [ -n "$server_addr" ] && uci set xfrpc.common.server_addr="$server_addr"
                    [ -n "$server_port" ] && uci set xfrpc.common.server_port="$server_port"
                    [ -n "$token" ] && uci set xfrpc.common.token="$token"
                    uci commit xfrpc
                    if [ "$enabled" = "0" ]; then
                        /etc/init.d/xfrpc stop >/dev/null 2>&1
                    else
                        /etc/init.d/xfrpc restart >/dev/null 2>&1
                    fi
                    ;;
                xkcptun)
                    [ -n "$enabled" ] && uci set xkcptun.client.enabled="$enabled"
                    [ -n "$server_addr" ] && uci set xkcptun.client.remote_addr="$server_addr"
                    [ -n "$server_port" ] && uci set xkcptun.client.remote_port="$server_port"
                    [ -n "$key" ] && uci set xkcptun.client.key="$key"
                    [ -n "$mode" ] && uci set xkcptun.client.mode="$mode"
                    [ -n "$fec" ] && uci set xkcptun.client.fec="$fec"
                    [ -n "$sndwnd" ] && uci set xkcptun.client.sndwnd="$sndwnd"
                    [ -n "$rcvwnd" ] && uci set xkcptun.client.rcvwnd="$rcvwnd"
                    [ -n "$datashard" ] && uci set xkcptun.client.datashard="$datashard"
                    [ -n "$parityshard" ] && uci set xkcptun.client.parityshard="$parityshard"
                    uci commit xkcptun
                    if [ "$enabled" = "0" ]; then
                        /etc/init.d/xkcptun stop >/dev/null 2>&1
                    else
                        /etc/init.d/xkcptun restart >/dev/null 2>&1
                    fi
                    ;;
                xdns)
                    [ -n "$enabled" ] && uci set xdns.global.enabled="$enabled"
                    [ -n "$xkcp_dns" ] && uci set xdns.global.xkcp_dns="$xkcp_dns"
                    [ -n "$xkcp_tcp" ] && uci set xdns.global.xkcp_tcp="$xkcp_tcp"
                    [ -n "$ifname" ] && uci set xdns.global.ifname="$ifname"
                    uci commit xdns
                    if [ "$enabled" = "0" ]; then
                        /etc/init.d/xdns stop >/dev/null 2>&1
                    else
                        /etc/init.d/xdns restart >/dev/null 2>&1
                    fi
                    ;;
                ipsec)
                    local remote_sec=$(uci -q show ipsec | grep '=remote' | cut -d. -f2 | cut -d= -f1 | head -n1)
                    [ -z "$remote_sec" ] && remote_sec="dhcs"
                    [ -n "$enabled" ] && uci set ipsec.${remote_sec}.enabled="$enabled"
                    [ -n "$gateway" ] && uci set ipsec.${remote_sec}.gateway="$gateway"
                    [ -n "$key" ] && uci set ipsec.${remote_sec}.pre_shared_key="$key"
                    uci commit ipsec
                    if [ "$enabled" = "0" ]; then
                        /etc/init.d/swanctl stop >/dev/null 2>&1
                    else
                        /etc/init.d/swanctl restart >/dev/null 2>&1
                    fi
                    ;;
                *)
                    success=0
                    msg="Unknown service: $service"
                    ;;
            esac
            
            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "service" "$service"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        
        get_qos_status() {
            lua -e '
local json = require "luci.jsonc"

local function format_bytes(bytes)
    bytes = tonumber(bytes) or 0
    if bytes >= 1073741824 then
        return string.format("%.2f GB", bytes / 1073741824)
    elseif bytes >= 1048576 then
        return string.format("%.2f MB", bytes / 1048576)
    elseif bytes >= 1024 then
        return string.format("%.1f KB", bytes / 1024)
    else
        return bytes .. " B"
    end
end

local function format_rate(rate_bps)
    rate_bps = tonumber(rate_bps) or 0
    local rate_bytes = rate_bps / 8
    local s_bytes = ""
    if rate_bytes >= 1048576 then
        s_bytes = string.format("%.2f MB/s", rate_bytes / 1048576)
    elseif rate_bytes >= 1024 then
        s_bytes = string.format("%.1f KB/s", rate_bytes / 1024)
    else
        s_bytes = string.format("%d B/s", math.floor(rate_bytes))
    end
    local s_bps = ""
    if rate_bps >= 1000000 then
        s_bps = string.format("%.2f Mbps", rate_bps / 1000000)
    elseif rate_bps >= 1000 then
        s_bps = string.format("%.1f Kbps", rate_bps / 1000)
    else
        s_bps = string.format("%d bps", rate_bps)
    end
    return string.format("%s (%s)", s_bytes, s_bps)
end

local bpf_run = os.execute("/etc/init.d/aw-bpf status 2>/dev/null | grep -q running") == 0

local ppe_status = "disabled"
local ppe_f = io.popen("/usr/bin/aw-bpfctl ppe status 2>/dev/null")
if ppe_f then
    local s = ppe_f:read("*a")
    ppe_f:close()
    if s:find("ready") or s:find("enabled:%s*1") then ppe_status = "ready" end
end

local fp_enabled = false
local fp_f = io.popen("/usr/bin/aw-bpfctl fastpath status 2>/dev/null")
if fp_f then
    local s = fp_f:read("*a")
    fp_f:close()
    if s:find("Enabled %(1%)") then fp_enabled = true end
end

local xdpi_enabled = false
local xdpi_f = io.popen("/usr/bin/aw-bpfctl xdpi status 2>/dev/null")
if xdpi_f then
    local s = xdpi_f:read("*a")
    xdpi_f:close()
    if s:find("Enabled %(1%)") then xdpi_enabled = true end
end

local devs = {}
local total_dl_bps = 0
local total_ul_bps = 0
local limited_count = 0

if bpf_run then
    local arp_mac = {}
    local f_arp = io.open("/proc/net/arp", "r")
    if f_arp then
        for line in f_arp:lines() do
            local ip, hw, flags, mac, mask, dev = line:match("(%S+)%s+(%S+)%s+(%S+)%s+(%S+)%s+(%S+)%s+(%S+)")
            if ip and mac and mac ~= "00:00:00:00:00:00" then
                arp_mac[ip] = mac:lower()
            end
        end
        f_arp:close()
    end

    local lease_hosts = {}
    local lease_macs = {}
    local lf = io.open("/tmp/dhcp.leases", "r")
    if lf then
        for line in lf:lines() do
            local parts = {}
            for w in line:gmatch("%S+") do table.insert(parts, w) end
            if #parts >= 4 then
                local mac = parts[2]:lower()
                local ip = parts[3]
                local host = parts[4]
                lease_hosts[ip] = host
                lease_macs[ip] = mac
            end
        end
        lf:close()
    end

    local f = io.popen("/usr/bin/aw-bpfctl ipv4 json all 2>/dev/null")
    if f then
        local s = f:read("*a")
        f:close()
        local obj = json.parse(s)
        if obj and obj.data then
            for _, item in ipairs(obj.data) do
                local ip = item.ip or ""
                local dl_rate = (item.incoming and item.incoming.rate) or 0
                local ul_rate = (item.outgoing and item.outgoing.rate) or 0
                local dl_bytes = (item.incoming and item.incoming.total_bytes) or 0
                local ul_bytes = (item.outgoing and item.outgoing.total_bytes) or 0
                local dl_limit = (item.incoming and item.incoming.incoming_rate_limit) or 0
                local ul_limit = (item.outgoing and item.outgoing.outgoing_rate_limit) or 0
                local is_lim = (dl_limit > 0 or ul_limit > 0)
                if is_lim then limited_count = limited_count + 1 end
                total_dl_bps = total_dl_bps + dl_rate
                total_ul_bps = total_ul_bps + ul_rate

                local mac = arp_mac[ip] or lease_macs[ip] or ""
                local host = lease_hosts[ip] or "unknown"
                if host == "*" or host == "" then host = "unknown" end

                local tr = item.time_rule or {}

                table.insert(devs, {
                    ip = ip,
                    mac = mac,
                    hostname = host,
                    dl_rate_bps = dl_rate,
                    ul_rate_bps = ul_rate,
                    dl_rate_human = format_rate(dl_rate),
                    ul_rate_human = format_rate(ul_rate),
                    total_dl_bytes = dl_bytes,
                    total_ul_bytes = ul_bytes,
                    total_bytes_human = format_bytes(dl_bytes + ul_bytes),
                    dl_limit_mbps = math.floor(dl_limit / 1048576),
                    ul_limit_mbps = math.floor(ul_limit / 1048576),
                    is_limited = is_lim,
                    time_rule = (tr and tr.enabled) and {
                        enabled = true,
                        desc = tr.desc or "生效中",
                        weekdays = tr.weekdays,
                        daytime_start = tr.daytime_start,
                        daytime_stop = tr.daytime_stop
                    } or { enabled = false }
                })
            end
        end
    end
end

table.sort(devs, function(a, b)
    local ra = (a.dl_rate_bps or 0) + (a.ul_rate_bps or 0)
    local rb = (b.dl_rate_bps or 0) + (b.ul_rate_bps or 0)
    if ra ~= rb then return ra > rb end
    local ta = (a.total_dl_bytes or 0) + (a.total_ul_bytes or 0)
    local tb = (b.total_dl_bytes or 0) + (b.total_ul_bytes or 0)
    return ta > tb
end)

print(json.stringify({
    result = {
        running = bpf_run,
        fastpath_enabled = fp_enabled,
        xdpi_enabled = xdpi_enabled,
        ppe_status = ppe_status,
        total_devices = #devs,
        limited_devices = limited_count,
        total_dl_rate_bps = total_dl_bps,
        total_ul_rate_bps = total_ul_bps,
        total_dl_rate_human = format_rate(total_dl_bps),
        total_ul_rate_human = format_rate(total_ul_bps),
        devices = devs
    }
}))
'
        }

        set_qos_limit() {
            read -r input
            json_load "$input"
            json_get_var target "target"
            json_get_var dl_mbps "dl_mbps"
            json_get_var ul_mbps "ul_mbps"
            json_get_var weekdays "weekdays"
            json_get_var timestart "timestart"
            json_get_var timestop "timestop"
            
            [ -z "$target" ] && {
                json_init
                json_add_object "result"
                json_add_boolean "success" "0"
                json_add_string "message" "目标设备 (IP、MAC 或 'all') 不能为空"
                json_close_object
                json_dump
                return
            }
            
            [ -z "$dl_mbps" ] && dl_mbps=0
            [ -z "$ul_mbps" ] && ul_mbps=0
            
            local dl_bps=0
            local ul_bps=0
            [ "$dl_mbps" -gt 0 ] 2>/dev/null && dl_bps=$((dl_mbps * 1048576))
            [ "$ul_mbps" -gt 0 ] 2>/dev/null && ul_bps=$((ul_mbps * 1048576))
            
            local time_opts=""
            if [ "$dl_mbps" -gt 0 ] || [ "$ul_mbps" -gt 0 ]; then
                [ -n "$weekdays" ] && time_opts="$time_opts --weekdays $weekdays"
                [ -n "$timestart" ] && time_opts="$time_opts --timestart $timestart"
                [ -n "$timestop" ] && time_opts="$time_opts --timestop $timestop"
            fi
            [ -z "$time_opts" ] && time_opts="--notime"
            
            local success=0
            local msg=""
            
            if [ "$target" = "all" ]; then
                if [ -x "/usr/bin/aw-bpfctl" ]; then
                    if [ "$dl_mbps" -eq 0 ] && [ "$ul_mbps" -eq 0 ]; then
                        /usr/bin/aw-bpfctl ipv4 update_all downrate 0 uprate 0 --notime >/dev/null 2>&1
                        /usr/bin/aw-bpfctl mac update_all downrate 0 uprate 0 --notime >/dev/null 2>&1
                        msg="已成功解除局域网所有在线设备的流控限速限制（恢复全速不限速）"
                    else
                        /usr/bin/aw-bpfctl ipv4 update_all downrate "$dl_bps" uprate "$ul_bps" $time_opts >/dev/null 2>&1
                        msg="已成功将局域网所有设备全局限速为：下行 ${dl_mbps} Mbps / 上行 ${ul_mbps} Mbps${weekdays:+ [生效星期: $weekdays]}${timestart:+ [生效时间: $timestart~$timestop]}"
                    fi
                    success=1
                fi
            elif echo "$target" | grep -q -E "^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$"; then
                # MAC address
                local target_mac=$(echo "$target" | tr 'A-F' 'a-f')
                local matched_ip=$(grep -i "$target_mac" /proc/net/arp 2>/dev/null | awk '{print $1}' | head -n1)
                [ -z "$matched_ip" ] && matched_ip=$(grep -i "$target_mac" /tmp/dhcp.leases 2>/dev/null | awk '{print $3}' | head -n1)
                
                if [ -x "/usr/bin/aw-bpfctl" ]; then
                    if [ "$dl_mbps" -eq 0 ] && [ "$ul_mbps" -eq 0 ]; then
                        /usr/bin/aw-bpfctl mac update "$target_mac" downrate 0 uprate 0 --notime >/dev/null 2>&1
                        [ -n "$matched_ip" ] && /usr/bin/aw-bpfctl ipv4 update "$matched_ip" downrate 0 uprate 0 --notime >/dev/null 2>&1
                        msg="已成功解除设备 (MAC: $target_mac${matched_ip:+, IP: $matched_ip}) 的限速规则（恢复不限速）"
                    else
                        /usr/bin/aw-bpfctl mac update "$target_mac" downrate "$dl_bps" uprate "$ul_bps" $time_opts >/dev/null 2>&1
                        [ -n "$matched_ip" ] && /usr/bin/aw-bpfctl ipv4 update "$matched_ip" downrate "$dl_bps" uprate "$ul_bps" $time_opts >/dev/null 2>&1
                        msg="已成功将设备 (MAC: $target_mac${matched_ip:+, IP: $matched_ip}) 限速为：下行 ${dl_mbps} Mbps / 上行 ${ul_mbps} Mbps${weekdays:+ [生效星期: $weekdays]}${timestart:+ [生效时间: $timestart~$timestop]}（内核 eBPF 实时生效）"
                    fi
                    success=1
                fi
            else
                # IPv4 address
                local target_ip="$target"
                local matched_mac=$(grep -w "$target_ip" /proc/net/arp 2>/dev/null | awk '{print $4}' | tr 'A-F' 'a-f' | head -n1)
                [ -z "$matched_mac" -o "$matched_mac" = "00:00:00:00:00:00" ] && matched_mac=$(grep -w "$target_ip" /tmp/dhcp.leases 2>/dev/null | awk '{print $2}' | tr 'A-F' 'a-f' | head -n1)
                
                if [ -x "/usr/bin/aw-bpfctl" ]; then
                    if [ "$dl_mbps" -eq 0 ] && [ "$ul_mbps" -eq 0 ]; then
                        /usr/bin/aw-bpfctl ipv4 update "$target_ip" downrate 0 uprate 0 --notime >/dev/null 2>&1
                        [ -n "$matched_mac" ] && /usr/bin/aw-bpfctl mac update "$matched_mac" downrate 0 uprate 0 --notime >/dev/null 2>&1
                        msg="已成功解除设备 $target_ip${matched_mac:+ (MAC: $matched_mac)} 的限速规则（恢复不限速）"
                    else
                        /usr/bin/aw-bpfctl ipv4 update "$target_ip" downrate "$dl_bps" uprate "$ul_bps" $time_opts >/dev/null 2>&1
                        [ -n "$matched_mac" ] && /usr/bin/aw-bpfctl mac update "$matched_mac" downrate "$dl_bps" uprate "$ul_bps" $time_opts >/dev/null 2>&1
                        msg="已成功将设备 $target_ip${matched_mac:+ (MAC: $matched_mac)} 限速为：下行 ${dl_mbps} Mbps / 上行 ${ul_mbps} Mbps${weekdays:+ [生效星期: $weekdays]}${timestart:+ [生效时间: $timestart~$timestop]}（内核 eBPF 实时生效）"
                    fi
                    success=1
                fi
            fi

            json_init
            json_add_object "result"
            json_add_boolean "success" "$success"
            json_add_string "target" "$target"
            json_add_int "dl_mbps" "$dl_mbps"
            json_add_int "ul_mbps" "$ul_mbps"
            json_add_string "weekdays" "${weekdays:-}"
            json_add_string "timestart" "${timestart:-}"
            json_add_string "timestop" "${timestop:-}"
            json_add_string "message" "$msg"
            json_close_object
            json_dump
        }

        get_l7_top() {
            lua -e '
local json = require "luci.jsonc"

local function format_bytes(bytes)
    bytes = tonumber(bytes) or 0
    if bytes >= 1073741824 then
        return string.format("%.2f GB", bytes / 1073741824)
    elseif bytes >= 1048576 then
        return string.format("%.2f MB", bytes / 1048576)
    elseif bytes >= 1024 then
        return string.format("%.1f KB", bytes / 1024)
    else
        return bytes .. " B"
    end
end

local function format_rate(rate)
    rate = tonumber(rate) or 0
    if rate >= 1048576 then
        return string.format("%.2f MB/s", rate / 1048576)
    elseif rate >= 1024 then
        return string.format("%.1f KB/s", rate / 1024)
    else
        return rate .. " B/s"
    end
end

