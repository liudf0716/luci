{
    "luci-app-clawwrt": {
        "description": "Grant access to LuCI app ClawWRT Copilot",
        "read": {
            "ubus": {
                "service": [
                    "list"
                ],
                "luci.clawwrt": [
                    "*"
                ]
            },
            "file": {
                "/etc/init.d/*": [
                    "exec"
                ],
                "/usr/bin/aw-bpfctl": [
                    "exec"
                ]
            },
            "uci": [
                "clawwrt",
                "xkcptun",
                "xfrpc",
                "xdns",
                "network",
                "firewall",
                "wireless",
                "dhcp",
                "wifidogx",
                "ipsec",
                "aw-bpf"
            ]
        },
        "write": {
            "uci": [
                "clawwrt",
                "xkcptun",
                "xfrpc",
                "xdns",
                "network",
                "firewall",
                "wireless",
                "dhcp",
                "wifidogx",
                "ipsec",
                "aw-bpf"
            ]
        }
    }
}