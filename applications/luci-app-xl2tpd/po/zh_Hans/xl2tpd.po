msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\\n"
"Language: zh_Hans\\n"

msgid "xl2tpd L2TP Configuration"
msgstr "xl2tpd L2TP 配置"

msgid "Configure L2TP VPN tunnels using xl2tpd daemon."
msgstr "使用 xl2tpd 守护进程配置 L2TP VPN 隧道。"

msgid "L2TP Interfaces"
msgstr "L2TP 接口"

msgid "Manage L2TP network interfaces. Each interface represents an L2TP tunnel connection."
msgstr "管理 L2TP 网络接口。每个接口代表一个 L2TP 隧道连接。"

msgid "Edit L2TP Interface"
msgstr "编辑 L2TP 接口"

msgid "General Settings"
msgstr "基本设置"

msgid "Advanced Options"
msgstr "高级选项"

msgid "Bring up on boot"
msgstr "开机启动"

msgid "Automatically bring up this interface on system boot"
msgstr "系统启动时自动启用此接口"

msgid "L2TP Server"
msgstr "L2TP 服务器"

msgid "L2TP server address in format: host[:port]. Port defaults to 1701."
msgstr "L2TP 服务器地址，格式为：主机[:端口]。端口默认为 1701。"

msgid "Username"
msgstr "用户名"

msgid "Username for PPP authentication"
msgstr "PPP 认证用户名"

msgid "Password"
msgstr "密码"

msgid "Password for PPP authentication"
msgstr "PPP 认证密码"

msgid "MTU"
msgstr "MTU"

msgid "Maximum Transmission Unit (MTU). Leave empty for default (1400)."
msgstr "最大传输单元（MTU）。留空则使用默认值（1400）。"

msgid "Enable IPv6"
msgstr "启用 IPv6"

msgid "Enable IPv6 support for this tunnel"
msgstr "为此隧道启用 IPv6 支持"

msgid "Keepalive"
msgstr "保活设置"

msgid "LCP echo keepalive in format: failure_count[,interval]. Example: 5,60 means send echo every 60 seconds, fail after 5 missed echoes."
msgstr "LCP 回显保活设置，格式为：失败次数[,间隔]。例如：5,60 表示每 60 秒发送一次回显，5 次未响应后判定失败。"

msgid "Invalid format. Use: failure_count[,interval]"
msgstr "格式无效。请使用：失败次数[,间隔]"

msgid "Values must be positive integers"
msgstr "值必须为正整数"

msgid "Checkup Interval"
msgstr "检查间隔"

msgid "Interval in seconds to check if interface is up and retry if down. Set to 0 to disable automatic retry."
msgstr "检查接口状态的间隔（秒）。如果接口断开则自动重试。设为 0 禁用自动重试。"

msgid "Additional PPP Options"
msgstr "附加 PPP 选项"

msgid "Additional options to pass to pppd daemon. One option per line."
msgstr "传递给 pppd 守护进程的附加选项。每行一个选项。"

msgid "Gateway Metric"
msgstr "网关优先级"

msgid "Metric for the default gateway"
msgstr "默认网关的优先级"

msgid "Use as default gateway"
msgstr "用作默认网关"

msgid "If enabled, use the tunnel as the default gateway"
msgstr "如果启用，则使用隧道作为默认网关"

msgid "Use DNS from peer"
msgstr "使用对端 DNS"

msgid "Use DNS servers provided by the peer"
msgstr "使用对端提供的 DNS 服务器"

msgid "xl2tpd L2TP Status"
msgstr "xl2tpd L2TP 状态"

msgid "Daemon Status"
msgstr "守护进程状态"

msgid "Service Status:"
msgstr "服务状态："

msgid "Running"
msgstr "运行中"

msgid "Stopped"
msgstr "已停止"

msgid "Active Tunnels"
msgstr "活跃隧道"

msgid "Tunnel Name"
msgstr "隧道名称"

msgid "Status"
msgstr "状态"

msgid "Information"
msgstr "信息"

msgid "Unknown"
msgstr "未知"

msgid "Active"
msgstr "活跃"

msgid "No active tunnels"
msgstr "没有活跃的隧道"

msgid "Restart Service"
msgstr "重启服务"

msgid "Refresh"
msgstr "刷新"

msgid "Restarting xl2tpd..."
msgstr "正在重启 xl2tpd..."

msgid "Please wait..."
msgstr "请稍候..."

msgid "xl2tpd service restarted"
msgstr "xl2tpd 服务已重启"

msgid "Failed to restart service: %s"
msgstr "重启服务失败：%s"

msgid "xl2tpd L2TP"
msgstr "xl2tpd L2TP"
