{
	"luci-app-gpsd": {
		"description": "Grant access to GPSD configuration",
		"read": {
			"uci": [ "gpsd" ],
			"file": {
				"/etc/init.d/gpsd": [ "exec" ],
				"/usr/bin/gpspipe": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "gpsd" ],
			"file": {
				"/etc/init.d/gpsd": [ "exec" ]
			}
		}
	}
}
