msgstr "启用 xfrpc 服务"

msgid "Enable iod service."
msgstr "启用碘服务"

msgid "Enable Subdomain"
msgstr "启用子域名"

msgid "Enable subdomain for http proxy"
msgstr "为 http 代理启用子域名"

msgid "Enable subdomain for https proxy"
msgstr "为 https 代理启用子域名"

msgid "Enable TCP multiplexing on the connection to frps. This reduces the number of connections."
msgstr "启用与 frps 连接的 TCP 多路复用。这将减少连接数量。"

msgid "Encryption"
msgstr "加密"

msgid "Compression"
msgstr "压缩"

msgid "End time"
msgstr "结束时间"

msgid "End time must be greater than start time"
msgstr "结束时间必须大于开始时间"

msgid "End time specifies the end time of the proxy service."
msgstr "结束时间指定代理服务的结束时间。"

msgid "End time specifies the end time of the proxy service. 0 means no restriction."
msgstr "结束时间指定代理服务的结束时间。0 表示无限制。"

msgid "Error"
msgstr "错误"

msgid "Execute"
msgstr "执行"

msgid "Execute the plugin action"
msgstr "执行插件操作"

msgid "Fallback to"
msgstr "回退到"

msgid "Fallback to another visitor when the connection fails."
msgstr "连接失败时回退到另一个访问者。"

msgid "For security, you can specify the service type to proxy to."
msgstr "出于安全考虑，您可以指定要代理的具体服务。"

msgid "General Settings"
msgstr "常规设置"

msgid "HTTP Basic Auth Password"
msgstr "HTTP 基本身份验证密码"

msgid "HTTP Basic Auth User"
msgstr "HTTP 基本身份验证用户"

msgid "HTTP Proxy"
msgstr "HTTP 代理"

msgid "HTTPS Proxy"
msgstr "HTTPS 代理"

msgid "Host header rewrite"
msgstr "Host 头重写"

msgid "Health check type"
msgstr "健康检查类型"

msgid "Health check URL"
msgstr "健康检查 URL"

msgid "Health check interval"
msgstr "健康检查间隔"

msgid "Health check timeout"
msgstr "健康检查超时"

msgid "Health check max failed"
msgstr "健康检查最大失败次数"

msgid "Type of health check to perform. Valid values are \"tcp\" and \"http\"."
msgstr "执行的健康检查类型。有效值为 \"tcp\" 和 \"http\"。"

msgid "URL path for HTTP health check. Only used when health check type is \"http\"."
msgstr "HTTP 健康检查的 URL 路径。仅在健康检查类型为 \"http\" 时使用。"

msgid "Interval between health checks, in seconds."
msgstr "健康检查之间的间隔，以秒为单位。"

msgid "Timeout for health check, in seconds."
msgstr "健康检查超时，以秒为单位。"

msgid "Max number of consecutive failed health checks before marking the proxy as unavailable."
msgstr "在将代理标记为不可用之前，连续失败的最大健康检查次数。"

msgid "Disabled"
msgstr "已禁用"

msgid "Heartbeat interval"
msgstr "心跳间隔"

msgid "Heartbeat timeout"
msgstr "心跳超时"

msgid "Interval between sending heartbeats to the server, in seconds. By default, this value is 30."
msgstr "向服务器发送心跳的间隔，以秒为单位。默认值为 30。"

msgid "IOD Settings"
msgstr "IOD 设置"

msgid "Info"
msgstr "信息"

msgid "Local IP"
msgstr "本地 IP"

msgid "Local IP specifies the IP address to proxy to."
msgstr "本地IP指定要代理到的 IP 地址"

msgid "Local port"
msgstr "本地端口"

msgid "Local port specifies the port to proxy to."
msgstr "本地端口指定要代理到的端口"

msgid "Locations"
msgstr "路由路径"

msgid "Log level"
msgstr "日志级别"

msgid "LogLevel specifies the minimum log level. Valid values are \"Debug\", \"Info\", \"Notice\", \"Warning\", \"Error\", \"Critical\", \"Alert\" and \"Emergency\"."
msgstr "LogLevel 指定最小日志等级。有效值为 \"Debug\"、\"Info\"、\"Notice\"、\"Warning\"、\"Error\"、\"Critical\"、\"Alert\" 和 \"Emergency\"。"

msgid "Multiplexer"
msgstr "多路复用器"

msgid "Specifies the multiplexer type for TCPMux proxy."
msgstr "指定 TCPMux 代理的多路复用器类型。"

msgid "NOT RUNNING"
msgstr "未在运行"

msgid "Notice"
msgstr "注意"

msgid "OIDC Auth"
msgstr "OIDC 认证"

msgid "OIDC Audience"
msgstr "OIDC 受众"

msgid "OIDC Client ID"
msgstr "OIDC 客户端 ID"

msgid "OIDC Client Secret"
msgstr "OIDC 客户端密钥"

msgid "OIDC Insecure Skip Verify"
msgstr "OIDC 跳过不安全验证"

msgid "OIDC Scope"
msgstr "OIDC 范围"

msgid "OIDC Token Endpoint URL"
msgstr "OIDC 令牌端点 URL"

msgid "OIDC Trusted CA File"
msgstr "OIDC 受信 CA 文件"

msgid "Password for HTTP Basic Authentication on the proxy."
msgstr "代理上 HTTP 基本身份验证的密码。"

msgid "Path to the TLS client certificate file."
msgstr "TLS 客户端证书文件路径。"

msgid "Path to the TLS client key file."
msgstr "TLS 客户端密钥文件路径。"

msgid "Path to the trusted CA certificate file for OIDC token endpoint."
msgstr "OIDC 令牌端点的受信 CA 证书文件路径。"

msgid "Path to the trusted CA certificate file for verifying the server."
msgstr "用于验证服务器的受信 CA 证书文件路径。"

msgid "Plugin Action"
msgstr "插件操作"

msgid "Plugin Name"
msgstr "插件名称"

msgid "Plugin Param"
msgstr "插件参数"

msgid "Plugin Settings"
msgstr "插件设置"

msgid "Protocol"
msgstr "协议"

msgid "Proxy Settings"
msgstr "代理设置"

msgid "QUIC bind port"
msgstr "QUIC 绑定端口"

msgid "RUNNING"
msgstr "运行中"

msgid "Remote Port"
msgstr "远程端口"

msgid "Remote port"
msgstr "远程端口"

msgid "Remote port specifies server-side port to proxy to."
msgstr "远程端口指定要代理到的服务器端口"

msgid "Remote port of plugin specifies the remote port of remote xfrpc plugin."
msgstr "插件的远程端口指定远程 xfrpc 插件的远程端口"

msgid "Request Headers"
msgstr "请求头"

msgid "Additional request headers, format: key1=val1,key2=val2"
msgstr "附加请求头，格式: key1=val1,key2=val2"

msgid "Response Headers"
msgstr "响应头"

msgid "Additional response headers, format: key1=val1,key2=val2"
msgstr "附加响应头，格式: key1=val1,key2=val2"

msgid "Rewrite the HTTP Host header to the specified value."
msgstr "将 HTTP Host 头重写为指定的值。"

msgid "SOCKS5 Proxy"
msgstr "SOCKS5 代理"

msgid "STCP Proxy"
msgstr "STCP 代理"

msgid "STCP Visitor"
msgstr "STCP 访问者"

msgid "SUDP Proxy"
msgstr "SUDP 代理"

msgid "Server address"
msgstr "服务器地址"

msgid "Server address specifies the address of the server to connect to."
msgstr "Server address 指定要连接的服务器的地址"

msgid "Server name"
msgstr "服务器名称"

msgid "Server port"
msgstr "服务器端口"

msgid "Server port specifies the port to connect to the server on."
msgstr "Server port 指定要连接的服务器端口"

msgid "Service Type"
msgstr "服务类型"

msgid "Specifies the subdomain for http or https proxy, only works when server support subdomain."
msgstr "指定 http 或 https 代理的子域名，仅在服务器支持子域名时有效"

msgid "Specifies the subdomain for http proxy, only works when server support subdomain."
msgstr "指定 http 代理的子域名，仅在服务器支持子域名时有效"

msgid "Specifies the subdomain for https proxy, only works when server support subdomain."
msgstr "指定 https 代理的子域名，仅在服务器支持子域名时有效"

msgid "Specifies the protocol used to connect to the server. Valid values are \"tcp\", \"kcp\" and \"quic\"."
msgstr "指定连接服务器使用的协议。有效值为 \"tcp\"、\"kcp\" 和 \"quic\"。"

msgid "Specifies the UDP port to bind for QUIC protocol. Only used when protocol is set to \"quic\"."
msgstr "指定 QUIC 协议绑定的 UDP 端口。仅在协议设置为 \"quic\" 时使用。"

msgid "Specifies the name of remote xfrpc plugin."
msgstr "指定远程 xfrpc 插件的名称"

msgid "Specifies the action sending to remote xfrpc plugin."
msgstr "指定发送到远程 xfrpc 插件的操作"

msgid "Specifies the parameter sending to remote xfrpc plugin."
msgstr "指定发送到远程 xfrpc 插件的参数"

msgid "Secret key"
msgstr "密钥"

msgid "Secret key for STCP authentication. Visitors must provide the same key to connect."
msgstr "STCP 认证的密钥。访问者必须提供相同的密钥才能连接。"

msgid "Secret key for STCP visitor authentication. Must match the STCP proxy secret key."
msgstr "STCP 访问者认证的密钥。必须与 STCP 代理的密钥匹配。"

msgid "Secret key for XTCP authentication. Visitors must provide the same key to connect."
msgstr "XTCP 认证的密钥。访问者必须提供相同的密钥才能连接。"

msgid "Secret key for XTCP visitor authentication. Must match the XTCP proxy secret key."
msgstr "XTCP 访问者认证的密钥。必须与 XTCP 代理的密钥匹配。"

msgid "Secret key for SUDP authentication."
msgstr "SUDP 认证的密钥。"

msgid "Startup Settings"
msgstr "启动设置"

msgid "Start time"
msgstr "开始时间"

msgid "Start time specifies the start time of the proxy service."
msgstr "开始时间指定代理服务的开始时间。"

msgid "Start time specifies the start time of the proxy service. 0 means no restriction."
msgstr "开始时间指定代理服务的开始时间。0 表示无限制。"

msgid "Subdomain"
msgstr "子域名"

msgid "TCP Mux"
msgstr "TCP 多路复用"

msgid "TCP Proxy"
msgstr "TCP 代理"

msgid "TCPMux Proxy"
msgstr "TCPMux 代理"

msgid "TLS Settings"
msgstr "TLS 设置"

msgid "TLS certificate file"
msgstr "TLS 证书文件"

msgid "TLS key file"
msgstr "TLS 密钥文件"

msgid "TLS server name"
msgstr "TLS 服务器名称"

msgid "TLS trusted CA file"
msgstr "TLS 受信 CA 文件"

msgid "The audience for the OIDC token request."
msgstr "OIDC 令牌请求的受众。"

msgid "The client ID for OIDC authentication."
msgstr "OIDC 认证的客户端 ID。"

msgid "The client secret for OIDC authentication."
msgstr "OIDC 认证的客户端密钥。"

msgid "The local address to bind for the visitor."
msgstr "访问者绑定的本地地址。"

msgid "The local port to bind for the visitor."
msgstr "访问者绑定的本地端口。"

msgid "The name of the STCP proxy on the server side to connect to."
msgstr "要连接的服务器端 STCP 代理名称。"

msgid "The name of the XTCP proxy on the server side to connect to."
msgstr "要连接的服务器端 XTCP 代理名称。"

msgid "The scope for the OIDC token request. Multiple scopes can be separated by spaces."
msgstr "OIDC 令牌请求的范围。多个范围可以用空格分隔。"

msgid "The URL of the OIDC token endpoint."
msgstr "OIDC 令牌端点的 URL。"

msgid "Timeout for heartbeat response from the server, in seconds. By default, this value is 90."
msgstr "服务器心跳响应的超时时间，以秒为单位。默认值为 90。"

msgid "Token"
msgstr "令牌"

msgid "Token specifies the authorization token used to create keys to be sent to the server. The server must have a matching token for authorization to succeed."
msgstr "Token 指定授权令牌，该令牌用于创建要发送到服务器的密钥。服务器必须有相匹配的令牌，授权才能成功。"

msgid "Transport Settings"
msgstr "传输设置"

msgid "URL routing paths, multiple paths separated by commas."
msgstr "URL 路由路径，多个路径用逗号分隔。"

msgid "URL routing paths, multiple paths separated by commas. E.g. \"/,/api\""
msgstr "URL 路由路径，多个路径用逗号分隔。例如：\"/,/api\""

msgid "Use Compression"
msgstr "使用压缩"

msgid "Use Encryption"
msgstr "使用加密"

msgid "Username for HTTP Basic Authentication on the proxy."
msgstr "代理上 HTTP 基本身份验证的用户名。"

msgid "Warning"
msgstr "警告"

msgid "XTCP Proxy"
msgstr "XTCP 代理"

msgid "XTCP Visitor"
msgstr "XTCP 访问者"

msgid "Bind address"
msgstr "绑定地址"

msgid "Bind port"
msgstr "绑定端口"

msgid "Allow users"
msgstr "允许用户"

msgid "Comma-separated list of usernames allowed to connect. Empty means all users."
msgstr "允许连接的用户名列表，用逗号分隔。为空表示允许所有用户。"

msgid "Enable encryption for this proxy. Traffic will be encrypted between frpc and frps."
msgstr "为此代理启用加密。frpc 和 frps 之间的流量将被加密。"

msgid "Enable compression for this proxy. Traffic will be compressed between frpc and frps."
msgstr "为此代理启用压缩。frpc 和 frps 之间的流量将被压缩。"

msgid "Enable TLS encryption for the connection to the server."
msgstr "为服务器连接启用 TLS 加密。"

msgid "Authentication method. Use \"token\" for simple token auth or \"oidc\" for OpenID Connect."
msgstr "认证方式。使用 \"token\" 进行简单令牌认证，或使用 \"oidc\" 进行 OpenID Connect 认证。"

msgid "Skip TLS certificate verification for the OIDC token endpoint. Not recommended for production."
msgstr "跳过 OIDC 令牌端点的 TLS 证书验证。不建议在生产环境中使用。"

msgid "Specifies the server name for TLS SNI. Used to verify the server certificate."
msgstr "指定 TLS SNI 的服务器名称。用于验证服务器证书。"

msgid "xfprc client"
msgstr "内网穿透客户端"

msgid "xfrpc"
msgstr "内网穿透"

msgid "xfrpc is a c language frp client for frps."
msgstr "xfrpc 是 frps 的 C 语言 frp 客户端"

msgid "start download video"
msgstr "开始下载视频"

msgid "stop download video"
msgstr "停止下载视频"

msgid "stop remote plugin service"
msgstr "停止远程插件服务"

msgid "please input profile url to download"
msgstr "请输入要下载的配置文件URL"

msgid "please input video url to download"
msgstr "请输入要下载的视频URL"

msgid "download video failed"
msgstr "下载视频失败"

msgid "stop download video failed"
msgstr "停止下载视频失败"

msgid "not support plugin"
msgstr "不支持的插件"

msgid "instagram video downloader"
msgstr "Instagram视频下载器"

msgid "youtube video downloader"
msgstr "YouTube视频下载器"

msgid "Disabled xfrpc service"
msgstr "禁用了 xfrpc 服务"

msgid "Reverse proxy"
msgstr "反向代理"

msgid "Grant access to LuCI app xfrpc"
msgstr "授予访问 LuCI 应用 xfrpc 的权限"

msgid "Name can not be \"common\""
msgstr "名称不能为\"common\""

msgid "ProxyType specifies the type of this proxy. Valid values include \"tcp\", \"http\", \"https\"."
msgstr "ProxyType 指定代理类型。有效值包括 \"tcp\"、\"http\"、\"https\"。"

msgid "By default, this value is \"tcp\"."
msgstr "此值默认为 \"tcp\""

msgid "LocalIp specifies the IP address or host name to proxy to."
msgstr "LocalIp 指定要经代理访问的 IP 地址或主机名"

msgid "LocalPort specifies the port to proxy to."
msgstr "LocalPort 指定要经代理访问的端口"

msgid "If remote_port is 0, frps will assign a random port for you."
msgstr "如远程端口为 0，frps 将给你分配一个随机的端口"

msgid "Custom Domain"
msgstr "自定义域名"

msgid "HTTP Settings"
msgstr "HTTP 设置"

msgid "xfrpc client"
msgstr "内网穿透客户端"
