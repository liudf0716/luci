# --- 现代化界面新增字符串 ---
msgid "3ginfo-lite Configuration"
msgstr "3ginfo-lite 配置"

msgid "3G/4G/5G Modem Configuration"
msgstr "3G/4G/5G 调制解调器配置"

msgid "Configure your modem settings, connection parameters, and diagnostic options for optimal performance."
msgstr "配置调制解调器参数、连接设置与诊断选项，以获得最佳性能。"

msgid "Basic Configuration"
msgstr "基础配置"

msgid "🌐 Network Interface"
msgstr "🌐 网络接口"

msgid "Select the network interface for Internet access."
msgstr "选择用于访问互联网的网络接口。"

msgid "This determines which network interface will be used for modem communication."
msgstr "此项决定用于与调制解调器通信的网络接口。"

msgid "🔌 Communication Port / IP Address"
msgstr "🔌 通信端口 / IP 地址"

msgid "Select the appropriate communication port or IP address for your modem type."
msgstr "根据调制解调器类型选择合适的通信端口或 IP 地址。"

msgid "Port Selection Guide:"
msgstr "端口选择指南："

msgid "• Traditional modem: Select ttyUSBX port"
msgstr "• 传统调制解调器：选择 ttyUSBX 端口"

msgid "• HiLink modem: Enter IP address (e.g., 192.168.1.1)"
msgstr "• HiLink 调制解调器：输入 IP 地址 (例如 192.168.1.1)"

msgid "📞 Auto Dial"
msgstr "📞 自动拨号"

msgid "Automatically establish connection on system startup."
msgstr "系统启动时自动建立连接。"

msgid "⚠️ Recommended for stable connections and automatic recovery."
msgstr "⚠️ 建议用于保持连接稳定并实现自动恢复。"

msgid "💤 Fast Dormancy"
msgstr "💤 快速休眠"

msgid "⏱️ Dormancy Time (seconds)"
msgstr "⏱️ 休眠时间 (秒)"

msgid "Duration (1-30 seconds) of inactivity before entering energy-saving mode."
msgstr "进入节能模式前的空闲持续时间 (1-30 秒)。"

msgid "Lower values save more power but may affect performance. Recommended: 5-10 seconds."
msgstr "较低的数值能节省更多能耗，但可能影响性能。推荐：5-10 秒。"

msgid "BTS Search Settings"
msgstr "BTS 搜索设置"

msgid "🌐 BTS Search Configuration"
msgstr "🌐 BTS 搜索配置"

msgid "Select a dedicated website for your location to search for Base Transceiver Stations (BTS). This helps identify nearby cell towers and optimize signal reception."
msgstr "为您所在位置选择适用的网站以搜索基站 (BTS)，有助于识别附近基站并优化信号接收。"

msgid "🌐 Search Website"
msgstr "🌐 搜索网站"

msgid "Choose the appropriate BTS search engine for your region."
msgstr "选择适合您所在地区的 BTS 搜索引擎。"

msgid "⚠️ Select the website that covers your geographical area for accurate results."
msgstr "⚠️ 请选择覆盖您地理区域的网站以获得准确结果。"

